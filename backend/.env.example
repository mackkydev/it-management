APP_NAME="IT-SYSTEM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Bangkok

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------- PostgreSQL (ฐานเดียวกับ Express) ----------
# โครงสร้างตารางจัดการด้วย Prisma (express/prisma) — ห้ามรัน php artisan migrate
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=it_system
DB_USERNAME=it_app
DB_PASSWORD=change_me_strong_password

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Production แนะนำ redis สำหรับ cache / queue / rate limiter
CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------- EAM ----------
# origin ของ frontend (คั่นด้วย , ถ้ามีหลายตัว)
FRONTEND_URLS=http://localhost:3000
# อายุ token (นาที) = 12 ชั่วโมง
EAM_TOKEN_TTL_MINUTES=720
# รหัสผ่านของผู้ใช้ตัวอย่างจาก seeder
SEED_ADMIN_PASSWORD=ChangeMe!2026

# ---------- อีเมลแจ้งเตือน (สัญญา/บัญชีใกล้หมดอายุ) ----------
# ใส่ค่า SMTP จริงแล้วเปลี่ยน MAIL_MAILER=smtp — ระหว่างยังไม่ตั้งค่าใช้ log (อีเมลจะถูกเขียนลง storage/logs)
# ทดสอบส่ง: docker exec it_api php artisan it:notify-expiring --dry-run
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="it-system@example.com"
MAIL_FROM_NAME="IT-SYSTEM"

# IT-SYSTEM Express API — คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit .env)
# production: ตั้งเป็นตัวแปร environment ของเซิร์ฟเวอร์แทนได้ แล้วตั้ง SKIP_ENV_FILES=1

APP_NAME="IT-SYSTEM"
# 32 ไบต์แบบ base64 — สร้างใหม่: node -e "console.log('base64:'+require('crypto').randomBytes(32).toString('base64'))"
# ถ้ามีข้อมูลเดิม ต้องใช้ค่าเดิม (คลังรหัสผ่านเข้ารหัสด้วยคีย์นี้)
APP_KEY=
APP_LOCALE=th
PORT=8020

# ---------- MySQL (docker: it_mysql → 127.0.0.1:3308) ----------
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=it_system
DB_USERNAME=it_app
DB_PASSWORD=
# ฐานชั่วคราวของ `prisma migrate dev` (เฉพาะเครื่องพัฒนา)
DB_SHADOW_DATABASE=it_system_shadow

# ---------- ความปลอดภัย ----------
BCRYPT_ROUNDS=12
EAM_TOKEN_TTL_MINUTES=720
# API User (login ผ่านระบบต้นทาง): ไม่ใช้งานเกินกี่นาทีต้อง login ใหม่ — อายุ session ไม่เกินอายุ token ต้นทางเสมอ
API_SESSION_IDLE_MINUTES=30
# timezone ของผู้ใช้ — ใช้ตัดสิน "วันนี้" ตอนตรวจวันที่ห้ามเป็นอนาคต (ฐานข้อมูลยังเก็บ UTC)
EAM_LOCAL_TIMEZONE=Asia/Bangkok

# ---------- การเชื่อมต่อ API User จาก .env (STEC SyteLine API) ----------
# อ่านตอนเปิด Express (แก้แล้วต้อง restart) — ตรวจค่าเหมือนหน้าเว็บ + บันทึก audit; เว้น API_CONN_BASE_URL ว่าง = ไม่ใช้ส่วนนี้
# API_CONN_SOURCE เลือกแหล่งค่า:
#   ui  (ค่าเริ่มต้น) = ตั้งที่หน้า "การเชื่อมต่อ API" — .env เป็นค่าสำรอง: สร้างให้ครั้งเดียวถ้ายังไม่มีการเชื่อมต่อชื่อ API_CONN_NAME
#   env = ใช้ค่าใน .env เสมอ — สร้าง/อัปเดตทุกครั้งที่เปิด Express และหน้าเว็บแก้/ลบการเชื่อมต่อนี้ไม่ได้ (ดู/ทดสอบได้)
# ค่าที่ไม่ได้ตั้ง = ค่าตามคู่มือ STEC (เหมือนปุ่ม "ตั้งค่าตามคู่มือ STEC")
API_CONN_SOURCE=ui
API_CONN_BASE_URL=
API_CONN_NAME="STEC SyteLine API"
API_CONN_ENABLED=true
# app_id:บทบาท คั่นด้วย , (บทบาท = manager / viewer) — ไม่ตรงกฎใด = API_CONN_DEFAULT_ROLE
API_CONN_ROLE_RULES=
API_CONN_DEFAULT_ROLE=viewer
# host/IP/CIDR ที่อนุญาต คั่นด้วย , — จำเป็นถ้าต้นทางอยู่ในเครือข่ายภายใน (IP private)
API_CONN_ALLOWED_HOSTS=
# API_CONN_TIMEOUT_MS=10000
# API_CONN_FORGOT_PASSWORD_URL=
# API_CONN_CHANGE_PASSWORD_URL=
# endpoint (ปกติไม่ต้องแก้):
# API_CONN_LOGIN_PATH=/api/v1/auth/login
# API_CONN_PROFILE_PATH=/api/v1/auth/permissions
# API_CONN_LOGOUT_PATH=/api/v1/auth/logout
# API_CONN_HEALTH_PATH=/health
# API_CONN_TOKEN_PATH=token
# API_CONN_TOKEN_TTL_PATH=expiresAt
# API_CONN_ROLE_CODE_PATH=appIds

FRONTEND_URLS=http://localhost:3000
# reverse proxy ที่เชื่อถือ X-Forwarded-For (ค่า trust proxy ของ Express)
# TRUST_PROXY=loopback, linklocal, uniquelocal

# ---------- ไฟล์แนบ (relative จาก express/ หรือ absolute) — ต้องสำรองข้อมูล ----------
FILES_ROOT=../storage/private

# ---------- อีเมลแจ้งเตือน ----------
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="it-system@example.com"
MAIL_FROM_NAME="IT-SYSTEM"

# ---------- งานแจ้งเตือนใกล้หมดอายุรายวัน (เปิดที่ instance เดียวเท่านั้น) ----------
SCHEDULER_ENABLED=false
SCHEDULE_NOTIFY_AT=08:00
SCHEDULE_TIMEZONE=Asia/Bangkok

# ---------- ข้อมูลตั้งต้น (npm run db:seed) ----------
SEED_ADMIN_PASSWORD=

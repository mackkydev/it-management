{
  "name": "it-system-express-api",
  "version": "1.0.0",
  "private": true,
  "description": "IT-SYSTEM REST API (Express.js) on MySQL 8.4",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "notify-expiring": "tsx src/cli/notify-expiring.ts",
    "notify-expiring:prod": "node dist/cli/notify-expiring.js",
    "security:check": "tsx src/cli/security-check.ts",
    "security:check:prod": "node dist/cli/security-check.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:validate": "prisma validate && prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:import-postgres": "tsx scripts/migrate-from-postgres.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "mysql2": "3.24.5",
    "nodemailer": "^10.1.0",
    "prisma": "7.10.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "pg": "8.23.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "mysql2": "$mysql2",
    "deepmerge-ts": "^8.0.2",
    "uuid": "^11.1.1"
  }
}

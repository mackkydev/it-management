/// การเชื่อมต่อ REST API ต้นทางสำหรับ API User — Local Admin ตั้งค่าที่หน้า "การเชื่อมต่อ API" (ไม่ hard-code)
/// path ใน response ใช้รูปแบบ dot path ที่ปลอดภัย (เช่น data.access_token, items.0.id) — ไม่ใช้ eval
model api_connections {
  id                        BigInt              @id @default(autoincrement())
  name                      String              @db.VarChar(100)
  /// เปิด/ปิดการ login ผ่าน API นี้
  is_enabled                Boolean             @default(false)
  /// ต้องเป็น https:// (ตรวจตอนบันทึก + ตอนเรียก)
  base_url                  String              @db.VarChar(500)
  timeout_ms                Int                 @default(10000)
  /// login: method / path / ชื่อ field ที่ส่ง / รูปแบบ body (json | form)
  login_method              String              @default("POST") @db.VarChar(10)
  login_path                String              @db.VarChar(255)
  login_username_field      String              @default("username") @db.VarChar(100)
  login_password_field      String              @default("password") @db.VarChar(100)
  login_body_type           String              @default("json") @db.VarChar(10)
  /// โปรไฟล์: profile_path = null → อ่านจาก response ของ login ที่ profile_root_path
  profile_method            String              @default("GET") @db.VarChar(10)
  profile_path              String?             @db.VarChar(255)
  profile_root_path         String?             @db.VarChar(255)
  logout_path               String?             @db.VarChar(255)
  refresh_path              String?             @db.VarChar(255)
  /// ตรวจว่าเข้าถึงต้นทางได้ (ไม่ต้องใช้บัญชี) เช่น /health ของ STEC SyteLine API — ปุ่ม "ตรวจการเข้าถึง"
  health_path               String?             @db.VarChar(255)
  /// path ของ token / อายุ token (วินาที) / refresh token ใน response — ไม่มีอายุ → default_token_ttl_seconds
  token_path                String              @default("token") @db.VarChar(255)
  token_ttl_path            String?             @db.VarChar(255)
  refresh_token_path        String?             @db.VarChar(255)
  default_token_ttl_seconds Int                 @default(86400)
  /// cache โปรไฟล์/สถานะผู้ใช้ก่อนตรวจกับต้นทางใหม่ (วินาที)
  profile_cache_seconds     Int                 @default(600)
  /// field mapping ของโปรไฟล์: { external_id, name, email, role_code } → path
  field_map                 Json                @default("{}")
  /// กฎ map role: [{ value: MGR, role: manager }] — ไม่ตรงกฎใด = default_role (สิทธิ์น้อยสุด)
  role_rules                Json                @default("[]")
  default_role              String              @default("viewer") @db.VarChar(20)
  /// error ต้นทาง: path ของรหัส error + { code: { kind, message_th, message_en } }
  error_code_path           String?             @db.VarChar(255)
  error_messages            Json                @default("{}")
  /// การยืนยันตัวตนของระบบเรากับต้นทาง: none | api_key | bearer | basic — auth_secret เข้ารหัส ห้ามส่งกลับ frontend
  auth_type                 String              @default("none") @db.VarChar(20)
  auth_header_name          String?             @db.VarChar(100)
  auth_username             String?             @db.VarChar(255)
  auth_secret               String?             @db.Text
  /// ป้องกัน SSRF: IP ภายใน/loopback/link-local ถูกบล็อก ยกเว้น host/IP/CIDR ในรายการนี้
  allowed_hosts             Json                @default("[]")
  max_redirects             Int                 @default(0) @db.SmallInt
  /// ลิงก์ไปหน้าของต้นทาง (ระบบเราไม่ทำ register / forgot / change password ให้ API User)
  register_url              String?             @db.VarChar(500)
  forgot_password_url       String?             @db.VarChar(500)
  change_password_url       String?             @db.VarChar(500)
  /// ซิงค์รายชื่อผู้ใช้ตามเวลา: endpoint รายชื่อ (ใช้การยืนยันตัวตนของการเชื่อมต่อ), path ของ array, การแบ่งหน้า
  users_list_path           String?             @db.VarChar(255)
  users_list_root_path      String?             @db.VarChar(255)
  users_page_param          String?             @db.VarChar(50)
  users_page_size_param     String?             @db.VarChar(50)
  users_page_size           Int                 @default(100)
  /// ค่าใน field_map.status ที่ถือว่า "ใช้งานได้" (ว่าง = ทุกคนในรายชื่อใช้งานได้)
  active_values             Json                @default("[]")
  /// 0 = ปิดการซิงค์ตามเวลา
  sync_interval_minutes     Int                 @default(0)
  last_synced_at            DateTime?           @db.DateTime(0)
  last_sync_result          Json?
  created_by                BigInt?
  updated_by                BigInt?
  created_at                DateTime?           @db.DateTime(0)
  updated_at                DateTime?           @db.DateTime(0)
  creator                   users?              @relation("api_connections_created_by", fields: [created_by], references: [id], onDelete: SetNull, map: "api_connections_created_by_foreign")
  updater                   users?              @relation("api_connections_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, map: "api_connections_updated_by_foreign")
  users                     users[]             @relation("users_connection")
  external_sessions         external_sessions[]
}

/// token ของต้นทาง (เข้ารหัส) ผูกกับ token ของระบบเรา 1:1 — browser ไม่เคยเห็น token ต้นทาง
/// ลบ token ของเรา (logout / หมดอายุ) → แถวนี้ถูกลบตาม (cascade)
model external_sessions {
  id                 BigInt                 @id @default(autoincrement())
  token_id           BigInt                 @unique(map: "external_sessions_token_id_unique")
  user_id            BigInt
  connection_id      BigInt
  access_token       String                 @db.Text
  refresh_token      String?                @db.Text
  expires_at         DateTime               @db.DateTime(0)
  /// ตรวจโปรไฟล์/สถานะกับต้นทางล่าสุด (cache ตาม profile_cache_seconds)
  profile_checked_at DateTime?              @db.DateTime(0)
  created_at         DateTime?              @db.DateTime(0)
  updated_at         DateTime?              @db.DateTime(0)
  token              personal_access_tokens @relation(fields: [token_id], references: [id], onDelete: Cascade, map: "external_sessions_token_id_foreign")
  user               users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "external_sessions_user_id_foreign")
  connection         api_connections        @relation(fields: [connection_id], references: [id], onDelete: Cascade, map: "external_sessions_connection_id_foreign")

  @@index([user_id], map: "external_sessions_user_id_index")
  @@index([expires_at], map: "external_sessions_expires_at_index")
}

/// รายการสิทธิ์ (permission key) — สิทธิ์จริง = role_permissions ของ role + user_permissions allow − deny
model permissions {
  id               BigInt             @id @default(autoincrement())
  key              String             @unique(map: "permissions_key_unique") @db.VarChar(100)
  group            String             @db.VarChar(50)
  name_th          String             @db.VarChar(200)
  name_en          String             @db.VarChar(200)
  sort_order       Int                @default(0) @db.SmallInt
  created_at       DateTime?          @db.DateTime(0)
  updated_at       DateTime?          @db.DateTime(0)
  role_permissions role_permissions[]
  user_permissions user_permissions[]
}

/// สิทธิ์ของแต่ละ role (admin | manager | viewer — ค่าเดียวกับ users.role)
model role_permissions {
  role          String      @db.VarChar(20)
  permission_id BigInt
  created_at    DateTime?   @db.DateTime(0)
  permission    permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, map: "role_permissions_permission_id_foreign")

  @@id([role, permission_id])
}

/// override สิทธิ์รายคน: effect = allow (เพิ่ม) | deny (ถอด)
model user_permissions {
  user_id       BigInt
  permission_id BigInt
  effect        String      @db.VarChar(10)
  created_by    BigInt?
  created_at    DateTime?   @db.DateTime(0)
  user          users       @relation("user_permissions_user", fields: [user_id], references: [id], onDelete: Cascade, map: "user_permissions_user_id_foreign")
  permission    permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, map: "user_permissions_permission_id_foreign")
  creator       users?      @relation("user_permissions_created_by", fields: [created_by], references: [id], onDelete: SetNull, map: "user_permissions_created_by_foreign")

  @@id([user_id, permission_id])
}

/// บันทึกการเปลี่ยนสิทธิ์ / การตั้งค่า / ลายเซ็น (ใคร เมื่อไร ก่อน-หลัง IP) — ห้ามเก็บ secret / token / รหัสผ่าน
model audit_logs {
  id           BigInt   @id @default(autoincrement())
  actor_id     BigInt?
  action       String   @db.VarChar(100)
  subject_type String   @db.VarChar(50)
  subject_id   String?  @db.VarChar(64)
  before       Json?
  after        Json?
  ip           String?  @db.VarChar(45)
  created_at   DateTime @default(now()) @db.DateTime(0)
  actor        users?   @relation(fields: [actor_id], references: [id], onDelete: SetNull, map: "audit_logs_actor_id_foreign")

  @@index([subject_type, subject_id], map: "audit_logs_subject_index")
  @@index([actor_id], map: "audit_logs_actor_id_index")
  @@index([created_at], map: "audit_logs_created_at_index")
}

/// แผนก (ข้อมูลหลัก) — users.department / approval_routes.department เก็บเป็นชื่อ (ข้อความ) เหมือนเดิม; เปลี่ยนชื่อที่นี่ = อัปเดตชื่อในผู้ใช้/สายอนุมัติด้วย
model departments {
  id         BigInt    @id @default(autoincrement())
  name       String    @unique(map: "departments_name_unique") @db.VarChar(100)
  is_active  Boolean   @default(true)
  sort_order Int       @default(0) @db.SmallInt
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
}

/// ฝ่าย (ข้อมูลหลัก) — users.division เก็บเป็นชื่อ (ข้อความ) เหมือนเดิม
model divisions {
  id         BigInt    @id @default(autoincrement())
  name       String    @unique(map: "divisions_name_unique") @db.VarChar(100)
  is_active  Boolean   @default(true)
  sort_order Int       @default(0) @db.SmallInt
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
}

/// ลายเซ็นของผู้ใช้ (เก็บในระบบเรา ไม่เกี่ยวกับระบบต้นทาง) — ลายเซ็นใหม่ทำให้อันเดิม is_active = false (ห้ามลบแถว = เก็บประวัติ)
/// ไฟล์ผ่านการ re-encode เป็น PNG (ล้าง metadata, crop ขอบ, กว้าง ≤ 600px) และเข้ารหัสขณะพัก (is_encrypted)
model user_signatures {
  id           BigInt   @id @default(autoincrement())
  user_id      BigInt
  file_ref     String   @db.VarChar(255)
  mime_type    String   @default("image/png") @db.VarChar(50)
  size         Int      @default(0)
  /// UPLOAD | DRAW
  source       String   @db.VarChar(10)
  is_active    Boolean  @default(true)
  /// false = ไฟล์เดิมก่อนมีตารางนี้ (ไม่ได้เข้ารหัส)
  is_encrypted Boolean  @default(true)
  created_at   DateTime @default(now()) @db.DateTime(0)
  created_by   BigInt?
  user         users    @relation("user_signatures_user", fields: [user_id], references: [id], onDelete: Cascade, map: "user_signatures_user_id_foreign")
  creator      users?   @relation("user_signatures_created_by", fields: [created_by], references: [id], onDelete: SetNull, map: "user_signatures_created_by_foreign")

  @@index([user_id, is_active], map: "user_signatures_user_id_is_active_index")
}

// โครงสร้างฐานข้อมูล IT-SYSTEM (MySQL 8.4) — Prisma เป็นเจ้าของ schema/migration
// API เรียกฐานข้อมูลผ่าน mysql2 (src/db.ts) ไม่ได้ใช้ Prisma Client
// แก้ไฟล์นี้แล้วสร้าง migration: npm run db:migrate -- --name <ชื่อ>
// ชื่อตาราง/คอลัมน์ตรงกับ Laravel (backend) เพื่อให้ Laravel ใช้เป็นตัวสำรองได้
datasource db {
  provider = "mysql"
}

model app_settings {
  key        String    @id @db.VarChar(100)
  value      Json?    
  updated_by BigInt?
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  users      users?    @relation(fields: [updated_by], references: [id], onUpdate: Restrict, map: "app_settings_updated_by_foreign")

  @@index([updated_by], map: "app_settings_updated_by_index")
}

/// ประกาศจากฝ่าย IT ที่แสดงบนหน้า login (ไม่ต้อง login ก็เห็น) — level: info | warning | danger
/// แสดงเมื่อ is_active และอยู่ในช่วง starts_on–ends_on (null = ไม่จำกัด) เรียงตาม sort_order
model announcements {
  id         BigInt    @id @default(autoincrement())
  title      String    @db.VarChar(200)
  body       String?   @db.Text
  level      String    @default("info") @db.VarChar(20)
  is_active  Boolean   @default(true)
  starts_on  DateTime? @db.Date
  ends_on    DateTime? @db.Date
  sort_order Int       @default(0) @db.SmallInt
  created_by BigInt?
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  users      users?    @relation(fields: [created_by], references: [id], onDelete: SetNull, map: "announcements_created_by_foreign")

  @@index([is_active, sort_order], map: "announcements_is_active_sort_order_index")
}

/// สายอนุมัติใบแจ้งงาน — จับคู่ผู้แจ้งตามสาขา+แผนก (null = ทุกสาขา/ทุกแผนก) หรือกำหนดรายบุคคลที่ users.approval_route_id
model approval_routes {
  id                   BigInt                 @id @default(autoincrement())
  name                 String                 @db.VarChar(255)
  branch_id            BigInt?
  department           String?                @db.VarChar(100)
  is_active            Boolean                @default(true)
  created_at           DateTime?              @db.DateTime(0)
  updated_at           DateTime?              @db.DateTime(0)
  branches             branches?              @relation(fields: [branch_id], references: [id], onUpdate: Restrict, map: "approval_routes_branch_id_foreign")
  approval_route_steps approval_route_steps[]
  users                users[]

  @@index([branch_id, is_active], map: "approval_routes_branch_id_is_active_index")
}

/// ขั้นของสายอนุมัติ (step_no เริ่มที่ 1) — ผู้อนุมัติคนใดคนหนึ่งในขั้นกดอนุมัติได้
model approval_route_steps {
  id                      BigInt                    @id @default(autoincrement())
  approval_route_id       BigInt
  step_no                 Int                       @db.SmallInt
  name                    String                    @db.VarChar(100)
  created_at              DateTime?                 @db.DateTime(0)
  updated_at              DateTime?                 @db.DateTime(0)
  approval_routes         approval_routes           @relation(fields: [approval_route_id], references: [id], onDelete: Cascade, map: "approval_route_steps_approval_route_id_foreign")
  approval_step_approvers approval_step_approvers[]

  @@unique([approval_route_id, step_no], map: "approval_route_steps_route_step_unique")
}

model approval_step_approvers {
  approval_route_step_id BigInt
  user_id                BigInt
  approval_route_steps   approval_route_steps @relation(fields: [approval_route_step_id], references: [id], onDelete: Cascade, map: "approval_step_approvers_step_id_foreign")
  users                  users                @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "approval_step_approvers_user_id_foreign")

  @@id([approval_route_step_id, user_id])
  @@index([user_id], map: "approval_step_approvers_user_id_index")
}

/// ขั้นอนุมัติของใบแจ้งงาน (คัดลอกจากสายตอนแจ้งงาน — แก้สายภายหลังไม่กระทบ)
/// status: pending | approved | rejected | skipped
model it_ticket_approval_steps {
  id           BigInt     @id @default(autoincrement())
  it_ticket_id BigInt
  step_no      Int        @db.SmallInt
  name         String     @db.VarChar(100)
  approver_ids Json      
  status       String     @default("pending") @db.VarChar(20)
  acted_by     BigInt?
  acted_at     DateTime?  @db.DateTime(0)
  comment      String?    @db.Text
  created_at   DateTime?  @db.DateTime(0)
  updated_at   DateTime?  @db.DateTime(0)
  it_tickets   it_tickets @relation(fields: [it_ticket_id], references: [id], onDelete: Cascade, map: "it_ticket_approval_steps_it_ticket_id_foreign")
  users        users?     @relation(fields: [acted_by], references: [id], onUpdate: Restrict, map: "it_ticket_approval_steps_acted_by_foreign")

  @@unique([it_ticket_id, step_no], map: "it_ticket_approval_steps_ticket_step_unique")
  @@index([acted_by], map: "it_ticket_approval_steps_acted_by_index")
}

/// ข้อมูล license ของสินทรัพย์หมวด SOFTWARE (1:1) — billing: yearly | custom | perpetual (perpetual = ไม่มีวันหมดอายุ)
model asset_licenses {
  id                      BigInt    @id @default(autoincrement())
  asset_id                BigInt    @unique(map: "asset_licenses_asset_id_unique")
  billing                 String    @db.VarChar(20)
  start_date              DateTime  @db.Date
  expires_at              DateTime? @db.Date
  seats                   Int?
  vendor                  String?   @db.VarChar(255)
  /// license key เข้ารหัสด้วย APP_KEY (รูปแบบเดียวกับ Laravel Crypt)
  license_key             String?   @db.Text
  notify_days_before      Int?      @db.SmallInt
  notified_for_expires_at DateTime? @db.Date
  created_at              DateTime? @db.DateTime(0)
  updated_at              DateTime? @db.DateTime(0)
  assets                  assets    @relation(fields: [asset_id], references: [id], onDelete: Cascade, map: "asset_licenses_asset_id_foreign")

  @@index([expires_at], map: "asset_licenses_expires_at_index")
}

/// การติดตั้ง software license — เครื่องเลือกจากสินทรัพย์ (device_asset_id) หรือพิมพ์ชื่อเครื่องเอง (device_name)
/// ใช้ seat ขณะ uninstalled_at เป็น null (ถอนการติดตั้งแล้วเก็บเป็นประวัติ)
model license_installations {
  id                                                    BigInt    @id @default(autoincrement())
  license_asset_id                                      BigInt
  device_asset_id                                       BigInt?
  device_name                                           String?   @db.VarChar(255)
  user_id                                               BigInt?
  branch_id                                             BigInt?
  installed_at                                          DateTime  @db.Date
  uninstalled_at                                        DateTime? @db.Date
  notes                                                 String?   @db.Text
  created_by                                            BigInt?
  created_at                                            DateTime? @db.DateTime(0)
  updated_at                                            DateTime? @db.DateTime(0)
  assets_license_installations_license_asset_idToassets assets    @relation("license_installations_license_asset_idToassets", fields: [license_asset_id], references: [id], onDelete: Cascade, map: "license_installations_license_asset_id_foreign")
  assets_license_installations_device_asset_idToassets  assets?   @relation("license_installations_device_asset_idToassets", fields: [device_asset_id], references: [id], onDelete: SetNull, map: "license_installations_device_asset_id_foreign")
  users_license_installations_user_idTousers            users?    @relation("license_installations_user_idTousers", fields: [user_id], references: [id], onDelete: SetNull, map: "license_installations_user_id_foreign")
  users_license_installations_created_byTousers         users?    @relation("license_installations_created_byTousers", fields: [created_by], references: [id], onDelete: SetNull, map: "license_installations_created_by_foreign")
  branches                                              branches? @relation(fields: [branch_id], references: [id], onDelete: SetNull, map: "license_installations_branch_id_foreign")

  @@index([license_asset_id, uninstalled_at], map: "license_installations_license_active_index")
  @@index([device_asset_id], map: "license_installations_device_asset_id_index")
  @@index([user_id], map: "license_installations_user_id_index")
  @@index([branch_id], map: "license_installations_branch_id_index")
}

/// ไฟล์แนบของสินทรัพย์ (เช่น ไฟล์ license) ใน private disk — path เป็น relative
model asset_files {
  id            BigInt    @id @default(autoincrement())
  asset_id      BigInt
  kind          String    @default("license") @db.VarChar(20)
  original_name String    @db.VarChar(255)
  path          String    @db.VarChar(255)
  mime          String    @db.VarChar(100)
  size          Int
  uploaded_by   BigInt?
  created_at    DateTime? @db.DateTime(0)
  updated_at    DateTime? @db.DateTime(0)
  assets        assets    @relation(fields: [asset_id], references: [id], onDelete: Cascade, map: "asset_files_asset_id_foreign")
  users         users?    @relation(fields: [uploaded_by], references: [id], onUpdate: Restrict, map: "asset_files_uploaded_by_foreign")

  @@index([asset_id], map: "asset_files_asset_id_index")
  @@index([uploaded_by], map: "asset_files_uploaded_by_index")
}

model asset_movements {
  id                                                    BigInt     @id @default(autoincrement())
  asset_id                                              BigInt
  type                                                  String     @db.VarChar(20)
  from_location_id                                      BigInt?
  to_location_id                                        BigInt?
  from_custodian_id                                     BigInt?
  to_custodian_id                                       BigInt?
  moved_at                                              DateTime   @db.DateTime(0)
  reason                                                String?    @db.Text
  performed_by                                          BigInt?
  created_at                                            DateTime   @default(now()) @db.DateTime(0)
  assets                                                assets     @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "asset_movements_asset_id_foreign")
  users_asset_movements_from_custodian_idTousers        users?     @relation("asset_movements_from_custodian_idTousers", fields: [from_custodian_id], references: [id], onUpdate: Restrict, map: "asset_movements_from_custodian_id_foreign")
  locations_asset_movements_from_location_idTolocations locations? @relation("asset_movements_from_location_idTolocations", fields: [from_location_id], references: [id], onUpdate: Restrict, map: "asset_movements_from_location_id_foreign")
  users_asset_movements_performed_byTousers             users?     @relation("asset_movements_performed_byTousers", fields: [performed_by], references: [id], onUpdate: Restrict, map: "asset_movements_performed_by_foreign")
  users_asset_movements_to_custodian_idTousers          users?     @relation("asset_movements_to_custodian_idTousers", fields: [to_custodian_id], references: [id], onUpdate: Restrict, map: "asset_movements_to_custodian_id_foreign")
  locations_asset_movements_to_location_idTolocations   locations? @relation("asset_movements_to_location_idTolocations", fields: [to_location_id], references: [id], onUpdate: Restrict, map: "asset_movements_to_location_id_foreign")

  @@index([asset_id, moved_at], map: "asset_movements_asset_id_moved_at_index")
  @@index([from_custodian_id], map: "asset_movements_from_custodian_id_index")
  @@index([from_location_id], map: "asset_movements_from_location_id_index")
  @@index([performed_by], map: "asset_movements_performed_by_index")
  @@index([to_custodian_id, moved_at], map: "asset_movements_to_custodian_id_moved_at_index")
  @@index([to_location_id, moved_at], map: "asset_movements_to_location_id_moved_at_index")
}

model assets {
  id                               BigInt                  @id @default(autoincrement())
  uuid                             String                  @unique(map: "assets_uuid_unique") @db.Char(36)
  asset_tag                        String                  @unique(map: "assets_asset_tag_unique") @db.VarChar(50)
  name                             String                  @db.VarChar(255)
  category                         String                  @db.VarChar(50)
  brand                            String?                 @db.VarChar(100)
  model                            String?                 @db.VarChar(100)
  serial_number                    String?                 @db.VarChar(100)
  status                           String                  @default("active") @db.VarChar(20)
  location_id                      BigInt?
  custodian_id                     BigInt?
  purchase_date                    DateTime?               @db.Date
  purchase_cost                    Decimal?                @db.Decimal(15, 2)
  warranty_expires_at              DateTime?               @db.Date
  notes                            String?                 @db.Text
  created_by                       BigInt?
  updated_by                       BigInt?
  created_at                       DateTime?               @db.DateTime(0)
  updated_at                       DateTime?               @db.DateTime(0)
  deleted_at                       DateTime?               @db.DateTime(0)
  /// สาขาของสินทรัพย์ (ตัวกรองหน้ารายการ) — import Excel จับคู่จาก Work Group ของสาขา
  branch_id                        BigInt?
  /// ข้อมูลเครื่องคอมพิวเตอร์ (หมวด COMPUTER — asset_tag = Host Name) ตามทะเบียน Excel ของฝ่าย IT
  /// department / user_name เก็บเป็นข้อความไปก่อน — ภายหลังดึงจากผู้ใช้ที่ได้จาก API; os / office ภายหลังผูกกับการติดตั้ง license
  department                       String?                 @db.VarChar(100)
  user_name                        String?                 @db.VarChar(255)
  received_date                    DateTime?               @db.Date
  start_use_date                   DateTime?               @db.Date
  work_group                       String?                 @db.VarChar(50)
  mac_address                      String?                 @db.VarChar(50)
  computer_type                    String?                 @db.VarChar(30)
  ip_address                       String?                 @db.VarChar(45)
  os                               String?                 @db.VarChar(100)
  office                           String?                 @db.VarChar(100)
  email_365                        String?                 @db.VarChar(255)
  antivirus                        String?                 @db.VarChar(100)
  notebook_tag                     String?                 @db.VarChar(100)
  cpu_tag                          String?                 @db.VarChar(100)
  monitor_tag                      String?                 @db.VarChar(255)
  branches                         branches?               @relation(fields: [branch_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "assets_branch_id_foreign")
  asset_files                      asset_files[]
  asset_licenses                   asset_licenses?
  license_installations_license    license_installations[] @relation("license_installations_license_asset_idToassets")
  license_installations_device     license_installations[] @relation("license_installations_device_asset_idToassets")
  asset_movements                  asset_movements[]
  users_assets_created_byTousers   users?                  @relation("assets_created_byTousers", fields: [created_by], references: [id], onUpdate: Restrict, map: "assets_created_by_foreign")
  users_assets_custodian_idTousers users?                  @relation("assets_custodian_idTousers", fields: [custodian_id], references: [id], onUpdate: Restrict, map: "assets_custodian_id_foreign")
  locations                        locations?              @relation(fields: [location_id], references: [id], onUpdate: Restrict, map: "assets_location_id_foreign")
  users_assets_updated_byTousers   users?                  @relation("assets_updated_byTousers", fields: [updated_by], references: [id], onUpdate: Restrict, map: "assets_updated_by_foreign")
  it_tickets                       it_tickets[]

  @@index([category, status], map: "assets_category_status_index")
  @@index([created_by], map: "assets_created_by_index")
  @@index([custodian_id], map: "assets_custodian_id_index")
  @@index([deleted_at, created_at], map: "assets_deleted_at_created_at_index")
  @@index([location_id], map: "assets_location_id_index")
  @@index([serial_number], map: "assets_serial_number_index")
  @@index([status, location_id], map: "assets_status_location_id_index")
  @@index([updated_by], map: "assets_updated_by_index")
  @@index([branch_id], map: "assets_branch_id_index")
}

model branches {
  id                    BigInt                  @id @default(autoincrement())
  code                  String                  @unique(map: "branches_code_unique") @db.VarChar(30)
  name                  String                  @db.VarChar(255)
  sort_order            Int                     @default(0) @db.SmallInt
  is_active             Boolean                 @default(true)
  created_at            DateTime?               @db.DateTime(0)
  updated_at            DateTime?               @db.DateTime(0)
  deleted_at            DateTime?               @db.DateTime(0)
  /// ชื่อ Work Group ของ Windows ที่สาขานี้ใช้ (เช่น LAMPHUN) — import ทะเบียนคอมพิวเตอร์จับคู่สาขาจากค่านี้ (ไม่ซ้ำ ไม่สนตัวพิมพ์)
  work_group            String?                 @unique(map: "branches_work_group_unique") @db.VarChar(50)
  approval_routes       approval_routes[]
  assets                assets[]
  license_installations license_installations[]
  contracts             contracts[]
  credentials           credentials[]
  it_tickets            it_tickets[]
  users                 users[]

  @@index([is_active, sort_order], map: "branches_is_active_sort_order_index")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.Text
  expiration BigInt

  @@index([expiration], map: "cache_expiration_index")
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration BigInt

  @@index([expiration], map: "cache_locks_expiration_index")
}

model contracts {
  id                    BigInt    @id @default(autoincrement())
  title                 String    @db.VarChar(255)
  vendor_name           String    @db.VarChar(255)
  contract_no           String?   @db.VarChar(100)
  start_date            DateTime  @db.Date
  end_date              DateTime  @db.Date
  amount                Decimal?  @db.Decimal(15, 2)
  contact_name          String?   @db.VarChar(255)
  contact_email         String?   @db.VarChar(255)
  contact_phone         String?   @db.VarChar(50)
  notify_days_before    Int?      @db.SmallInt
  notify_enabled        Boolean   @default(true)
  notified_for_end_date DateTime? @db.Date
  notified_at           DateTime? @db.DateTime(0)
  notes                 String?   @db.Text
  branch_id             BigInt?
  created_by            BigInt?
  created_at            DateTime? @db.DateTime(0)
  updated_at            DateTime? @db.DateTime(0)
  deleted_at            DateTime? @db.DateTime(0)
  branches              branches? @relation(fields: [branch_id], references: [id], onUpdate: Restrict, map: "contracts_branch_id_foreign")
  users                 users?    @relation(fields: [created_by], references: [id], onUpdate: Restrict, map: "contracts_created_by_foreign")

  @@index([branch_id], map: "contracts_branch_id_index")
  @@index([created_by], map: "contracts_created_by_index")
  @@index([end_date, notify_enabled], map: "contracts_end_date_notify_enabled_index")
}

model credential_access_logs {
  id            BigInt      @id @default(autoincrement())
  credential_id BigInt
  user_id       BigInt?
  action        String      @db.VarChar(20)
  ip            String?     @db.VarChar(45)
  created_at    DateTime    @default(now()) @db.DateTime(0)
  credentials   credentials @relation(fields: [credential_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "credential_access_logs_credential_id_foreign")
  users         users?      @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "credential_access_logs_user_id_foreign")

  @@index([credential_id, created_at], map: "credential_access_logs_credential_id_created_at_index")
  @@index([user_id], map: "credential_access_logs_user_id_index")
}

model credentials {
  id                                  BigInt                   @id @default(autoincrement())
  title                               String                   @db.VarChar(255)
  category                            String                   @default("system") @db.VarChar(30)
  url                                 String?                  @db.VarChar(500)
  username                            String?                  @db.VarChar(255)
  password                            String?                  @db.Text
  secret_notes                        String?                  @db.Text
  notes                               String?                  @db.Text
  branch_id                           BigInt?
  owner_id                            BigInt?
  expires_at                          DateTime?                @db.Date
  notified_for_expires_at             DateTime?                @db.Date
  created_by                          BigInt?
  updated_by                          BigInt?
  password_changed_at                 DateTime?                @db.DateTime(0)
  created_at                          DateTime?                @db.DateTime(0)
  updated_at                          DateTime?                @db.DateTime(0)
  deleted_at                          DateTime?                @db.DateTime(0)
  credential_access_logs              credential_access_logs[]
  branches                            branches?                @relation(fields: [branch_id], references: [id], onUpdate: Restrict, map: "credentials_branch_id_foreign")
  users_credentials_created_byTousers users?                   @relation("credentials_created_byTousers", fields: [created_by], references: [id], onUpdate: Restrict, map: "credentials_created_by_foreign")
  users_credentials_owner_idTousers   users?                   @relation("credentials_owner_idTousers", fields: [owner_id], references: [id], onUpdate: Restrict, map: "credentials_owner_id_foreign")
  users_credentials_updated_byTousers users?                   @relation("credentials_updated_byTousers", fields: [updated_by], references: [id], onUpdate: Restrict, map: "credentials_updated_by_foreign")

  @@index([branch_id], map: "credentials_branch_id_index")
  @@index([category, title], map: "credentials_category_title_index")
  @@index([created_by], map: "credentials_created_by_index")
  @@index([owner_id], map: "credentials_owner_id_index")
  @@index([updated_by], map: "credentials_updated_by_index")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.VarChar(255)
  queue      String   @db.VarChar(255)
  payload    String   @db.Text
  exception  String   @db.Text
  failed_at  DateTime @default(now()) @db.DateTime(0)

  @@index([connection, queue, failed_at], map: "failed_jobs_connection_queue_failed_at_index")
}

model it_ticket_attachments {
  id            BigInt     @id @default(autoincrement())
  it_ticket_id  BigInt
  kind          String     @db.VarChar(20)
  path          String     @db.VarChar(255)
  original_name String?    @db.VarChar(255)
  mime          String?    @db.VarChar(100)
  size          Int        @default(0)
  uploaded_by   BigInt?
  created_at    DateTime?  @db.DateTime(0)
  updated_at    DateTime?  @db.DateTime(0)
  it_tickets    it_tickets @relation(fields: [it_ticket_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "it_ticket_attachments_it_ticket_id_foreign")
  users         users?     @relation(fields: [uploaded_by], references: [id], onUpdate: Restrict, map: "it_ticket_attachments_uploaded_by_foreign")

  @@index([it_ticket_id, kind], map: "it_ticket_attachments_it_ticket_id_kind_index")
  @@index([uploaded_by], map: "it_ticket_attachments_uploaded_by_index")
}

model it_ticket_events {
  id           BigInt     @id @default(autoincrement())
  it_ticket_id BigInt

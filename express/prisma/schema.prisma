  /// hash รหัสผ่าน — ใช้เฉพาะ LOCAL (API User ไม่เก็บรหัสผ่านใด ๆ = null; CHECK users_local_password_check)
  password                                                 String?                    @db.VarChar(255)
  /// LOCAL = ผู้ใช้ของระบบเรา (ค่าเริ่มต้น — ผู้ใช้เดิมทั้งหมด) / API = ผู้ใช้จาก REST API ต้นทาง (JIT provisioning)
  type                                                     String                     @default("LOCAL") @db.VarChar(10)
  /// API User: การเชื่อมต่อต้นทาง + รหัสผู้ใช้ที่ต้นทาง (unique คู่กัน)
  connection_id                                            BigInt?

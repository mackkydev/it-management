  signature_path                                           String?                    @db.VarChar(255)
  /// สายอนุมัติที่กำหนดรายบุคคล (null = จับคู่อัตโนมัติตามสาขา+แผนก)
  approval_route_id                                        BigInt?
  created_at                                               DateTime?                  @db.DateTime(0)
  updated_at                                               DateTime?                  @db.DateTime(0)
  approval_routes                                          approval_routes?           @relation(fields: [approval_route_id], references: [id], onDelete: SetNull, map: "users_approval_route_id_foreign")
  approval_step_approvers                                  approval_step_approvers[]
  asset_files                                              asset_files[]
  announcements                                            announcements[]
  license_installations_user                               license_installations[]    @relation("license_installations_user_idTousers")
  license_installations_created                            license_installations[]    @relation("license_installations_created_byTousers")
  it_ticket_approval_steps                                 it_ticket_approval_steps[]
  app_settings                                             app_settings[]
  kpi_entries                                              kpi_entries[]
  asset_movements_asset_movements_from_custodian_idTousers asset_movements[]          @relation("asset_movements_from_custodian_idTousers")
  asset_movements_asset_movements_performed_byTousers      asset_movements[]          @relation("asset_movements_performed_byTousers")
  asset_movements_asset_movements_to_custodian_idTousers   asset_movements[]          @relation("asset_movements_to_custodian_idTousers")
  assets_assets_created_byTousers                          assets[]                   @relation("assets_created_byTousers")
  assets_assets_custodian_idTousers                        assets[]                   @relation("assets_custodian_idTousers")
  assets_assets_updated_byTousers                          assets[]                   @relation("assets_updated_byTousers")
  contracts                                                contracts[]
  credential_access_logs                                   credential_access_logs[]
  credentials_credentials_created_byTousers                credentials[]              @relation("credentials_created_byTousers")
  credentials_credentials_owner_idTousers                  credentials[]              @relation("credentials_owner_idTousers")

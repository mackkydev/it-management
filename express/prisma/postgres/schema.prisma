/// การเชื่อมต่อ REST API ต้นทางสำหรับ API User — Local Admin ตั้งค่าที่หน้า "การเชื่อมต่อ API" (ไม่ hard-code)
/// path ใน response ใช้รูปแบบ dot path ที่ปลอดภัย (เช่น data.access_token, items.0.id) — ไม่ใช้ eval
model api_connections {
  id                        BigInt              @id @default(autoincrement())
  name                      String              @db.Citext
  /// เปิด/ปิดการ login ผ่าน API นี้
  is_enabled                Boolean             @default(false)
  /// ต้องเป็น https:// (ตรวจตอนบันทึก + ตอนเรียก)
  base_url                  String              @db.Citext
  timeout_ms                Int                 @default(10000)
  /// login: method / path / ชื่อ field ที่ส่ง / รูปแบบ body (json | form)
  login_method              String              @default("POST") @db.Citext
  login_path                String              @db.Citext
  login_username_field      String              @default("username") @db.Citext
  login_password_field      String              @default("password") @db.Citext
  login_body_type           String              @default("json") @db.Citext
  /// โปรไฟล์: profile_path = null → อ่านจาก response ของ login ที่ profile_root_path
  profile_method            String              @default("GET") @db.Citext
  profile_path              String?             @db.Citext
  profile_root_path         String?             @db.Citext
  logout_path               String?             @db.Citext
  refresh_path              String?             @db.Citext
  /// ตรวจว่าเข้าถึงต้นทางได้ (ไม่ต้องใช้บัญชี) เช่น /health ของ STEC SyteLine API — ปุ่ม "ตรวจการเข้าถึง"
  health_path               String?             @db.Citext
  /// path ของ token / อายุ token (วินาที) / refresh token ใน response — ไม่มีอายุ → default_token_ttl_seconds
  token_path                String              @default("token") @db.Citext
  token_ttl_path            String?             @db.Citext
  refresh_token_path        String?             @db.Citext
  default_token_ttl_seconds Int                 @default(86400)
  /// cache โปรไฟล์/สถานะผู้ใช้ก่อนตรวจกับต้นทางใหม่ (วินาที)
  profile_cache_seconds     Int                 @default(600)
  /// field mapping ของโปรไฟล์: { external_id, name, email, role_code } → path
  field_map                 Json                @default("{}")
  /// กฎ map role: [{ value: MGR, role: manager }] — ไม่ตรงกฎใด = default_role (สิทธิ์น้อยสุด)
  role_rules                Json                @default("[]")
  default_role              String              @default("viewer") @db.Citext
  /// error ต้นทาง: path ของรหัส error + { code: { kind, message_th, message_en } }
  error_code_path           String?             @db.Citext
  error_messages            Json                @default("{}")
  /// การยืนยันตัวตนของระบบเรากับต้นทาง: none | api_key | bearer | basic — auth_secret เข้ารหัส ห้ามส่งกลับ frontend
  auth_type                 String              @default("none") @db.Citext
  auth_header_name          String?             @db.Citext
  auth_username             String?             @db.Citext
  auth_secret               String?             @db.Citext
  /// ป้องกัน SSRF: IP ภายใน/loopback/link-local ถูกบล็อก ยกเว้น host/IP/CIDR ในรายการนี้
  allowed_hosts             Json                @default("[]")
  max_redirects             Int                 @default(0) @db.SmallInt
  /// ลิงก์ไปหน้าของต้นทาง (ระบบเราไม่ทำ register / forgot / change password ให้ API User)
  register_url              String?             @db.Citext
  forgot_password_url       String?             @db.Citext
  change_password_url       String?             @db.Citext
  /// ซิงค์รายชื่อผู้ใช้ตามเวลา: endpoint รายชื่อ (ใช้การยืนยันตัวตนของการเชื่อมต่อ), path ของ array, การแบ่งหน้า
  users_list_path           String?             @db.Citext
  users_list_root_path      String?             @db.Citext
  users_page_param          String?             @db.Citext
  users_page_size_param     String?             @db.Citext
  users_page_size           Int                 @default(100)
  /// ค่าใน field_map.status ที่ถือว่า "ใช้งานได้" (ว่าง = ทุกคนในรายชื่อใช้งานได้)
  active_values             Json                @default("[]")
  /// 0 = ปิดการซิงค์ตามเวลา
  sync_interval_minutes     Int                 @default(0)
  last_synced_at            DateTime?           @db.Timestamp(0)
  last_sync_result          Json?
  created_by                BigInt?
  updated_by                BigInt?
  created_at                DateTime?           @db.Timestamp(0)
  updated_at                DateTime?           @db.Timestamp(0)
  creator                   users?              @relation("api_connections_created_by", fields: [created_by], references: [id], onDelete: SetNull, map: "api_connections_created_by_foreign")
  updater                   users?              @relation("api_connections_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, map: "api_connections_updated_by_foreign")
  users                     users[]             @relation("users_connection")
  external_sessions         external_sessions[]
}

/// token ของต้นทาง (เข้ารหัส) ผูกกับ token ของระบบเรา 1:1 — browser ไม่เคยเห็น token ต้นทาง
/// ลบ token ของเรา (logout / หมดอายุ) → แถวนี้ถูกลบตาม (cascade)
model external_sessions {
  id                 BigInt                 @id @default(autoincrement())
  token_id           BigInt                 @unique(map: "external_sessions_token_id_unique")
  user_id            BigInt
  connection_id      BigInt
  access_token       String                 @db.Citext
  refresh_token      String?                @db.Citext
  expires_at         DateTime               @db.Timestamp(0)
  /// ตรวจโปรไฟล์/สถานะกับต้นทางล่าสุด (cache ตาม profile_cache_seconds)
  profile_checked_at DateTime?              @db.Timestamp(0)
  created_at         DateTime?              @db.Timestamp(0)
  updated_at         DateTime?              @db.Timestamp(0)
  token              personal_access_tokens @relation(fields: [token_id], references: [id], onDelete: Cascade, map: "external_sessions_token_id_foreign")
  user               users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "external_sessions_user_id_foreign")
  connection         api_connections        @relation(fields: [connection_id], references: [id], onDelete: Cascade, map: "external_sessions_connection_id_foreign")

  @@index([user_id], map: "external_sessions_user_id_index")
  @@index([expires_at], map: "external_sessions_expires_at_index")
}

/// รายการสิทธิ์ (permission key) — สิทธิ์จริง = role_permissions ของ role + user_permissions allow − deny
model permissions {
  id               BigInt             @id @default(autoincrement())
  key              String             @unique(map: "permissions_key_unique") @db.Citext
  group            String             @db.Citext
  name_th          String             @db.Citext
  name_en          String             @db.Citext
  sort_order       Int                @default(0) @db.SmallInt
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  role_permissions role_permissions[]
  user_permissions user_permissions[]
}

/// สิทธิ์ของแต่ละกลุ่ม — role = permission_groups.key (กลุ่มตามตำแหน่ง users.role หรือกลุ่มที่สร้างเอง)
model role_permissions {
  role          String      @db.Citext
  permission_id BigInt
  created_at    DateTime?   @db.Timestamp(0)
  permission    permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, map: "role_permissions_permission_id_foreign")

  @@id([role, permission_id])
}

/// override สิทธิ์รายคน: effect = allow (เพิ่ม) | deny (ถอด)
model user_permissions {
  user_id       BigInt
  permission_id BigInt
  effect        String      @db.Citext
  created_by    BigInt?
  created_at    DateTime?   @db.Timestamp(0)
  /// ใช้ได้ถึงวันนี้ (เวลาไทย) — null = ไม่หมดอายุ; มีผลเมื่อเปิด app_settings.permission_expiry
  expires_on    DateTime?   @db.Date
  user          users       @relation("user_permissions_user", fields: [user_id], references: [id], onDelete: Cascade, map: "user_permissions_user_id_foreign")
  permission    permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, map: "user_permissions_permission_id_foreign")
  creator       users?      @relation("user_permissions_created_by", fields: [created_by], references: [id], onDelete: SetNull, map: "user_permissions_created_by_foreign")

  @@id([user_id, permission_id])
}

/// กลุ่มสิทธิ์ — is_system = กลุ่มตามตำแหน่ง (super_admin | admin | division_manager | manager | viewer, ลบไม่ได้) / อื่นๆ = กลุ่มที่สร้างเอง
/// สิทธิ์ของกลุ่มอยู่ที่ role_permissions (role = key) — super_admin ผ่านทุกสิทธิ์ (ไม่ใช้ตาราง)
model permission_groups {
  key         String        @id @db.Citext
  name_th     String        @db.Citext
  name_en     String        @db.Citext
  is_system   Boolean       @default(false)
  sort_order  Int           @default(0) @db.SmallInt
  created_at  DateTime?     @db.Timestamp(0)
  updated_at  DateTime?     @db.Timestamp(0)
  user_groups user_groups[]
}

/// ผู้ใช้อยู่ในกลุ่มสิทธิ์เพิ่มจากกลุ่มตามตำแหน่ง (หลายกลุ่มได้) — expires_on = ใช้ได้ถึงวันนี้ (null = ไม่หมดอายุ)
model user_groups {
  user_id    BigInt
  group_key  String            @db.Citext
  expires_on DateTime?         @db.Date
  created_by BigInt?
  created_at DateTime?         @db.Timestamp(0)
  user       users             @relation("user_groups_user", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_groups_user_id_foreign")
  group      permission_groups @relation(fields: [group_key], references: [key], onDelete: Cascade, onUpdate: Restrict, map: "user_groups_group_key_foreign")
  creator    users?            @relation("user_groups_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "user_groups_created_by_foreign")

  @@id([user_id, group_key])
  @@index([group_key], map: "user_groups_group_key_index")
  @@index([created_by], map: "user_groups_created_by_index")
}

/// บันทึกการเปลี่ยนสิทธิ์ / การตั้งค่า / ลายเซ็น (ใคร เมื่อไร ก่อน-หลัง IP) — ห้ามเก็บ secret / token / รหัสผ่าน
model audit_logs {
  id           BigInt   @id @default(autoincrement())
  actor_id     BigInt?
  action       String   @db.Citext
  subject_type String   @db.Citext
  subject_id   String?  @db.Citext
  before       Json?
  after        Json?
  ip           String?  @db.Citext
  /// เบราว์เซอร์/อุปกรณ์ของผู้ใช้ (หน้าเว็บส่งต่อใน X-Client-Agent, ลงท้าย " [pwa]" = เปิดจากแอปที่ติดตั้ง)
  user_agent   String?  @db.Citext
  created_at   DateTime @default(now()) @db.Timestamp(0)
  actor        users?   @relation(fields: [actor_id], references: [id], onDelete: SetNull, map: "audit_logs_actor_id_foreign")

  @@index([subject_type, subject_id], map: "audit_logs_subject_index")
  @@index([actor_id], map: "audit_logs_actor_id_index")
  @@index([created_at], map: "audit_logs_created_at_index")
  @@index([action], map: "audit_logs_action_index")
}

/// แผนก (ข้อมูลหลัก) — users.department / approval_routes.department เก็บเป็นชื่อ (ข้อความ) เหมือนเดิม; เปลี่ยนชื่อที่นี่ = อัปเดตชื่อในผู้ใช้/สายอนุมัติด้วย
model departments {
  id          BigInt     @id @default(autoincrement())
  name        String     @unique(map: "departments_name_unique") @db.Citext
  is_active   Boolean    @default(true)
  sort_order  Int        @default(0) @db.SmallInt
  /// ฝ่ายที่สังกัด (ไม่บังคับ)
  division_id BigInt?
  created_at  DateTime?  @db.Timestamp(0)
  updated_at  DateTime?  @db.Timestamp(0)
  divisions   divisions? @relation(fields: [division_id], references: [id], onUpdate: Restrict, map: "departments_division_id_foreign")

  @@index([division_id], map: "departments_division_id_index")
}

/// ฝ่าย (ข้อมูลหลัก) — users.division เก็บเป็นชื่อ (ข้อความ) เหมือนเดิม
model divisions {
  id          BigInt        @id @default(autoincrement())
  name        String        @unique(map: "divisions_name_unique") @db.Citext
  is_active   Boolean       @default(true)
  sort_order  Int           @default(0) @db.SmallInt
  created_at  DateTime?     @db.Timestamp(0)
  updated_at  DateTime?     @db.Timestamp(0)
  departments departments[]
}

/// ลายเซ็นของผู้ใช้ (เก็บในระบบเรา ไม่เกี่ยวกับระบบต้นทาง) — ลายเซ็นใหม่ทำให้อันเดิม is_active = false (ห้ามลบแถว = เก็บประวัติ)
/// ไฟล์ผ่านการ re-encode เป็น PNG (ล้าง metadata, crop ขอบ, กว้าง ≤ 600px) และเข้ารหัสขณะพัก (is_encrypted)
model user_signatures {
  id           BigInt   @id @default(autoincrement())
  user_id      BigInt
  file_ref     String   @db.Citext
  mime_type    String   @default("image/png") @db.Citext
  size         Int      @default(0)
  /// UPLOAD | DRAW
  source       String   @db.Citext
  is_active    Boolean  @default(true)
  /// false = ไฟล์เดิมก่อนมีตารางนี้ (ไม่ได้เข้ารหัส)
  is_encrypted Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamp(0)
  created_by   BigInt?
  user         users    @relation("user_signatures_user", fields: [user_id], references: [id], onDelete: Cascade, map: "user_signatures_user_id_foreign")
  creator      users?   @relation("user_signatures_created_by", fields: [created_by], references: [id], onDelete: SetNull, map: "user_signatures_created_by_foreign")

  @@index([user_id, is_active], map: "user_signatures_user_id_is_active_index")
}

/// ใบลา — อนุมัติโดยหัวหน้าที่ผู้ลาระบุ (ตั้งต้น = หัวหน้าตามสาย) แล้วจึงขึ้นปฏิทิน + แถว KPI
/// unit: full | half_am | half_pm | hours (start_time/end_time) — days = วันทำงานจริง (ไม่นับ ส-อา / วันหยุดบริษัท)
model leave_requests {
  id                                      BigInt        @id @default(autoincrement())
  uuid                                    String        @unique(map: "leave_requests_uuid_unique") @db.Citext
  user_id                                 BigInt
  leave_type                              String        @db.Citext
  unit                                    String        @default("full") @db.Citext
  start_on                                DateTime      @db.Date
  end_on                                  DateTime      @db.Date
  start_time                              String?       @db.Citext
  end_time                                String?       @db.Citext
  days                                    Decimal       @default(0) @db.Decimal(5, 2)
  reason                                  String?       @db.Citext
  approver_id                             BigInt?
  status                                  String        @default("pending") @db.Citext
  decided_at                              DateTime?     @db.Timestamp(0)
  decision_note                           String?       @db.Citext
  cancelled_by                            BigInt?
  created_at                              DateTime?     @db.Timestamp(0)
  updated_at                              DateTime?     @db.Timestamp(0)
  users_leave_requests_user_idTousers     users         @relation("leave_requests_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "leave_requests_user_id_foreign")
  users_leave_requests_approver_idTousers users?        @relation("leave_requests_approver_idTousers", fields: [approver_id], references: [id], onUpdate: Restrict, map: "leave_requests_approver_id_foreign")
  leave_files                             leave_files[]

  @@index([user_id, status], map: "leave_requests_user_id_status_index")
  @@index([approver_id, status], map: "leave_requests_approver_id_status_index")
  @@index([start_on, end_on], map: "leave_requests_start_on_end_on_index")
}

/// เหตุการณ์ในปฏิทิน — onsite = ช่วงวันไปทำงานหน้างานจากใบแจ้งงาน (1 ใบ = 1 ช่วง)
model calendar_events {
  id                                      BigInt      @id @default(autoincrement())
  type                                    String      @default("onsite") @db.Citext
  user_id                                 BigInt
  ticket_id                               BigInt?     @unique(map: "calendar_events_ticket_id_unique")
  title                                   String      @db.Citext
  start_on                                DateTime    @db.Date
  end_on                                  DateTime    @db.Date
  note                                    String?     @db.Citext
  /// type event: แสดงทั้งบริษัท (ไม่กรองตามขอบเขต)
  all_company                             Boolean     @default(false)
  /// type event: ไม่รวมเสาร์-อาทิตย์ (แสดงเฉพาะวันธรรมดาในช่วงวัน)
  skip_weekends                           Boolean     @default(false)
  created_by                              BigInt?
  created_at                              DateTime?   @db.Timestamp(0)
  updated_at                              DateTime?   @db.Timestamp(0)
  users_calendar_events_user_idTousers    users       @relation("calendar_events_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "calendar_events_user_id_foreign")
  it_tickets                              it_tickets? @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "calendar_events_ticket_id_foreign")
  users_calendar_events_created_byTousers users?      @relation("calendar_events_created_byTousers", fields: [created_by], references: [id], onUpdate: Restrict, map: "calendar_events_created_by_foreign")

  @@index([user_id], map: "calendar_events_user_id_index")
  @@index([start_on, end_on], map: "calendar_events_start_on_end_on_index")
}

/// วันหยุดประจำปีของบริษัท — ผู้ดูแลระบบเพิ่มเอง / นำเข้า Excel; ขึ้นปฏิทินทุกคน + แถววันหยุดใน KPI
model company_holidays {
  id                BigInt            @id @default(autoincrement())
  calendar_id       BigInt
  date              DateTime          @db.Date
  name              String            @db.Citext
  created_by        BigInt?
  created_at        DateTime?         @db.Timestamp(0)
  updated_at        DateTime?         @db.Timestamp(0)
  users             users?            @relation(fields: [created_by], references: [id], onUpdate: Restrict, map: "company_holidays_created_by_foreign")
  holiday_calendars holiday_calendars @relation(fields: [calendar_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "company_holidays_calendar_id_foreign")

  @@unique([calendar_id, date], map: "company_holidays_calendar_date_unique")
}

/// ปฏิทินวันหยุดแต่ละชุด (เช่น สำนักงานใหญ่ / สำนักงานโรงงาน) — สาขาเลือกใช้ 1 ชุด, ไม่เลือก = ชุดตั้งต้น (is_default)
model holiday_calendars {
  id               BigInt             @id @default(autoincrement())
  name             String             @unique(map: "holiday_calendars_name_unique") @db.Citext
  is_default       Boolean            @default(false)
  sort_order       Int                @default(0) @db.SmallInt
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  company_holidays company_holidays[]
  branches         branches[]
}

/// โควตาวันลารายคนต่อปี (ไม่มี = ค่าตั้งต้นใน app_settings.leave_settings.quotas)
model leave_quota_overrides {
  user_id    BigInt
  year       Int       @db.SmallInt
  leave_type String    @db.Citext
  days       Decimal   @db.Decimal(5, 2)
  updated_by BigInt?
  updated_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "leave_quota_overrides_user_id_foreign")

  @@id([user_id, year, leave_type])
}

/// ไฟล์แนบใบลา (ใบรับรองแพทย์) — private disk
model leave_files {
  id             BigInt         @id @default(autoincrement())
  leave_id       BigInt
  path           String         @db.Citext
  original_name  String         @db.Citext
  mime           String?        @db.Citext
  size           Int?
  created_at     DateTime?      @db.Timestamp(0)
  leave_requests leave_requests @relation(fields: [leave_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "leave_files_leave_id_foreign")

  @@index([leave_id], map: "leave_files_leave_id_index")
}

/// ห้องประชุม — seats = แถวจำนวนที่นั่ง [{ label, count }] (เช่น ที่นั่งหลัก / ที่นั่งสำรอง)
model meeting_rooms {
  id                  BigInt                @id @default(autoincrement())
  name                String                @unique(map: "meeting_rooms_name_unique") @db.Citext
  branch_id           BigInt?
  location            String?               @db.Citext
  room_no             String?               @db.Citext
  description         String?               @db.Citext
  seats               Json
  is_active           Boolean               @default(true)
  sort_order          Int                   @default(0) @db.SmallInt
  created_at          DateTime?             @db.Timestamp(0)
  updated_at          DateTime?             @db.Timestamp(0)
  branches            branches?             @relation(fields: [branch_id], references: [id], onUpdate: Restrict, map: "meeting_rooms_branch_id_foreign")
  meeting_room_images meeting_room_images[]
  meeting_bookings    meeting_bookings[]

  @@index([branch_id], map: "meeting_rooms_branch_id_index")
}

/// รูปห้องประชุม (≤ 4 รูปต่อห้อง, is_primary = รูปหลักที่แสดง) — ไฟล์ WebP ที่ประมวลผลใหม่ใน storage/private/meeting-rooms/{room}/
model meeting_room_images {
  id            BigInt        @id @default(autoincrement())
  room_id       BigInt
  path          String        @db.Citext
  size          Int?
  is_primary    Boolean       @default(false)
  sort_order    Int           @default(0) @db.SmallInt
  created_at    DateTime?     @db.Timestamp(0)
  meeting_rooms meeting_rooms @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "meeting_room_images_room_id_foreign")

  @@index([room_id], map: "meeting_room_images_room_id_index")
}

/// การจองห้องประชุม (วันเดียว: booking_date + start_time/end_time "HH:MM") — status: confirmed | cancelled; ลบ = deleted_at
/// purpose = ข้อความจาก dropdown_options (list meeting_purpose); department = แผนกของผู้จองตอนจอง
model meeting_bookings {
  id                        BigInt                      @id @default(autoincrement())
  uuid                      String                      @unique(map: "meeting_bookings_uuid_unique") @db.Citext
  room_id                   BigInt
  user_id                   BigInt
  department                String?                     @db.Citext
  title                     String                      @db.Citext
  attendees                 Int                         @db.SmallInt
  purpose                   String?                     @db.Citext
  note                      String?                     @db.Citext
  booking_date              DateTime                    @db.Date
  /// จองหลายวัน: วันสุดท้าย (ช่วงเวลาเดียวกันทุกวัน) — null = วันเดียว (ข้อมูลเดิม)
  end_date                  DateTime?                   @db.Date
  start_time                String                      @db.Citext
  end_time                  String                      @db.Citext
  status                    String                      @default("confirmed") @db.Citext
  cancelled_at              DateTime?                   @db.Timestamp(0)
  cancelled_by              BigInt?
  created_at                DateTime?                   @db.Timestamp(0)
  updated_at                DateTime?                   @db.Timestamp(0)
  deleted_at                DateTime?                   @db.Timestamp(0)
  meeting_rooms             meeting_rooms               @relation(fields: [room_id], references: [id], onUpdate: Restrict, map: "meeting_bookings_room_id_foreign")
  users                     users                       @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "meeting_bookings_user_id_foreign")
  meeting_booking_equipment meeting_booking_equipment[]

  zoom_bookings zoom_bookings[]

  @@index([room_id, booking_date], map: "meeting_bookings_room_id_booking_date_index")
  @@index([room_id, end_date], map: "meeting_bookings_room_id_end_date_index")
  @@index([booking_date], map: "meeting_bookings_booking_date_index")
  @@index([user_id], map: "meeting_bookings_user_id_index")
}

/// อุปกรณ์ที่ขอใช้ในการจอง (ชื่อจาก dropdown_options list meeting_equipment)
model meeting_booking_equipment {
  booking_id       BigInt
  name             String           @db.Citext
  meeting_bookings meeting_bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "meeting_booking_equipment_booking_id_foreign")

  @@id([booking_id, name])
}

/// รถส่วนกลาง — mileage = เลขไมล์ล่าสุด (อัปเดตจากเลขไมล์ที่บันทึกในการจอง หรือผู้จัดการแก้เอง)
model vehicles {
  id                BigInt              @id @default(autoincrement())
  name              String              @unique(map: "vehicles_name_unique") @db.Citext
  plate_no          String?             @unique(map: "vehicles_plate_no_unique") @db.Citext
  branch_id         BigInt?
  seats             Int                 @db.SmallInt
  parking           String?             @db.Citext
  description       String?             @db.Citext
  mileage           Int?
  /// ประเภทรถ / เชื้อเพลิง — ข้อความจาก dropdown_options list vehicle_type / vehicle_fuel
  vehicle_type      String?             @db.Citext
  fuel_type         String?             @db.Citext
  is_active         Boolean             @default(true)
  sort_order        Int                 @default(0) @db.SmallInt
  created_at        DateTime?           @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  branches          branches?           @relation(fields: [branch_id], references: [id], onUpdate: Restrict, map: "vehicles_branch_id_foreign")
  vehicle_images    vehicle_images[]
  vehicle_bookings  vehicle_bookings[]
  vehicle_transfers vehicle_transfers[]

  @@index([branch_id], map: "vehicles_branch_id_index")
}

/// ประวัติการย้ายรถไปสาขาอื่น (NULL = ใช้ร่วมกันทุกสาขา) — เพิ่มอย่างเดียว ห้ามแก้/ลบ
model vehicle_transfers {
  id             BigInt    @id @default(autoincrement())
  vehicle_id     BigInt
  from_branch_id BigInt?
  to_branch_id   BigInt?
  note           String?   @db.Citext
  created_by     BigInt?
  created_at     DateTime? @db.Timestamp(0)
  vehicles       vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "vehicle_transfers_vehicle_id_foreign")
  from_branch    branches? @relation("vehicle_transfer_from", fields: [from_branch_id], references: [id], onUpdate: Restrict, map: "vehicle_transfers_from_branch_id_foreign")
  to_branch      branches? @relation("vehicle_transfer_to", fields: [to_branch_id], references: [id], onUpdate: Restrict, map: "vehicle_transfers_to_branch_id_foreign")
  users          users?    @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "vehicle_transfers_created_by_foreign")

  @@index([vehicle_id, created_at], map: "vehicle_transfers_vehicle_id_created_at_index")
  @@index([from_branch_id], map: "vehicle_transfers_from_branch_id_index")
  @@index([to_branch_id], map: "vehicle_transfers_to_branch_id_index")
  @@index([created_by], map: "vehicle_transfers_created_by_index")
}

/// รูปรถ (≤ 4 รูปต่อคัน, is_primary = รูปหลัก) — ไฟล์ WebP ใน storage/private/vehicles/{vehicle}/
model vehicle_images {
  id         BigInt    @id @default(autoincrement())
  vehicle_id BigInt
  path       String    @db.Citext
  size       Int?
  is_primary Boolean   @default(false)
  sort_order Int       @default(0) @db.SmallInt
  created_at DateTime? @db.Timestamp(0)
  vehicles   vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "vehicle_images_vehicle_id_foreign")

  @@index([vehicle_id], map: "vehicle_images_vehicle_id_index")
}

/// การจองรถ (หลายวันได้: start_on + start_time ถึง end_on + end_time "HH:MM" เวลาไทย) — vehicle_id NULL = รอผู้จัดคิวรถเลือกรถ
/// status: confirmed | cancelled; ลบ = deleted_at; purpose = dropdown_options list vehicle_purpose; เลขไมล์เริ่มต้น/สิ้นสุดของการใช้งาน
model vehicle_bookings {
  id                     BigInt                   @id @default(autoincrement())
  uuid                   String                   @unique(map: "vehicle_bookings_uuid_unique") @db.Citext
  vehicle_id             BigInt?
  user_id                BigInt
  department             String?                  @db.Citext
  details                String                   @db.Citext
  passengers             Int                      @db.SmallInt
  purpose                String?                  @db.Citext
  note                   String?                  @db.Citext
  start_on               DateTime                 @db.Date
  start_time             String                   @db.Citext
  end_on                 DateTime                 @db.Date
  end_time               String                   @db.Citext
  start_mileage          Int?
  end_mileage            Int?
  status                 String                   @default("confirmed") @db.Citext
  assigned_by            BigInt?
  assigned_at            DateTime?                @db.Timestamp(0)
  cancelled_at           DateTime?                @db.Timestamp(0)
  cancelled_by           BigInt?
  /// การอนุมัติโดยผู้จัดคิวรถ: status pending (รออนุมัติ) → confirmed (อนุมัติ) / rejected (ไม่อนุมัติ + เหตุผล)
  approved_by            BigInt?
  approved_at            DateTime?                @db.Timestamp(0)
  rejected_by            BigInt?
  rejected_at            DateTime?                @db.Timestamp(0)
  reject_reason          String?                  @db.Citext
  created_at             DateTime?                @db.Timestamp(0)
  updated_at             DateTime?                @db.Timestamp(0)
  deleted_at             DateTime?                @db.Timestamp(0)
  /// สาขาที่ขอใช้รถ (ยังไม่ระบุรถ = ผู้จัดคิวของสาขานี้เลือกรถ) — ตั้งตอนจอง: รถที่เลือก → สาขาของรถ, ไม่เลือก → สาขาที่ผู้จองเลือก
  branch_id              BigInt?
  /// ผู้จองขอคนขับ (เลือกเพิ่มเติม "คนขับรถ") / คนขับที่ผู้จัดคิวเลือก / เหตุผลที่ยกเลิก (ผู้จัดคิวยกเลิกแทนผู้จอง)
  needs_driver           Boolean                  @default(false)
  driver_id              BigInt?
  cancel_reason          String?                  @db.Citext
  branches               branches?                @relation(fields: [branch_id], references: [id], onUpdate: Restrict, map: "vehicle_bookings_branch_id_foreign")
  vehicle_drivers        vehicle_drivers?         @relation(fields: [driver_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "vehicle_bookings_driver_id_foreign")
  vehicles               vehicles?                @relation(fields: [vehicle_id], references: [id], onUpdate: Restrict, map: "vehicle_bookings_vehicle_id_foreign")
  users                  users                    @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "vehicle_bookings_user_id_foreign")
  vehicle_booking_extras vehicle_booking_extras[]

  @@index([vehicle_id, start_on, end_on], map: "vehicle_bookings_vehicle_id_start_on_end_on_index")
  @@index([start_on, end_on], map: "vehicle_bookings_start_on_end_on_index")
  @@index([user_id], map: "vehicle_bookings_user_id_index")
  @@index([branch_id], map: "vehicle_bookings_branch_id_index")
  @@index([driver_id, start_on, end_on], map: "vehicle_bookings_driver_id_start_on_end_on_index")
}

/// รายการเพิ่มเติมที่ขอ (ชื่อจาก dropdown_options list vehicle_extra เช่น น้ำมันเต็มถัง / Easy Pass)
model vehicle_booking_extras {
  booking_id       BigInt
  name             String           @db.Citext
  vehicle_bookings vehicle_bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "vehicle_booking_extras_booking_id_foreign")

  @@id([booking_id, name])
}

/// ยืมอุปกรณ์ IT (สินทรัพย์ที่เจ้าหน้าที่ IT ถือครอง) — จอง (reserved) → ส่งมอบ (on_loan) → รับคืน (returned) / ยกเลิก (cancelled)
/// ช่วงเวลา = start_on + start_time ถึง end_on + end_time ("HH:MM" เวลาไทย) — on_loan เลยกำหนดคืน = เกินกำหนด (แจ้งเตือนวันละครั้ง overdue_notified_on)
model equipment_loans {
  id                  BigInt    @id @default(autoincrement())
  uuid                String    @unique(map: "equipment_loans_uuid_unique") @db.Citext
  /// NULL = คำขอที่เจ้าหน้าที่ IT ยังไม่เลือกเครื่อง (migration 20261213090000_loan_prepare_return)
  asset_id            BigInt?
  user_id             BigInt
  department          String?   @db.Citext
  purpose             String    @db.Citext
  /// อุปกรณ์เสริมที่ให้ยืม (key ใน LOAN_ACCESSORIES) / ที่ตรวจรับคืนแล้ว
  accessories          Json?
  returned_accessories Json?
  /// รูปตอนส่งมอบ / รับคืน [{ id, path, size, stage }]
  photos               Json?
  /// ผู้ยืมกดคืนเครื่อง (รอเจ้าหน้าที่ IT ยืนยันรับคืน)
  return_requested_at  DateTime? @db.Timestamp(0)
  note                String?   @db.Citext
  start_on            DateTime  @db.Date
  start_time          String    @db.Citext
  end_on              DateTime  @db.Date
  end_time            String    @db.Citext
  status              String    @default("reserved") @db.Citext
  handed_out_at       DateTime? @db.Timestamp(0)
  handed_out_by       BigInt?
  returned_at         DateTime? @db.Timestamp(0)
  returned_by         BigInt?
  return_note         String?   @db.Citext
  overdue_notified_on DateTime? @db.Date
  cancelled_at        DateTime? @db.Timestamp(0)
  cancelled_by        BigInt?
  created_at          DateTime? @db.Timestamp(0)
  updated_at          DateTime? @db.Timestamp(0)
  assets              assets?   @relation(fields: [asset_id], references: [id], onUpdate: Restrict, map: "equipment_loans_asset_id_foreign")
  users               users     @relation("equipment_loans_user", fields: [user_id], references: [id], onUpdate: Restrict, map: "equipment_loans_user_id_foreign")
  handed_by_user      users?    @relation("equipment_loans_handed", fields: [handed_out_by], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "equipment_loans_handed_out_by_foreign")
  returned_by_user    users?    @relation("equipment_loans_returned", fields: [returned_by], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "equipment_loans_returned_by_foreign")
  cancelled_by_user   users?    @relation("equipment_loans_cancelled", fields: [cancelled_by], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "equipment_loans_cancelled_by_foreign")

  @@index([asset_id, start_on, end_on], map: "equipment_loans_asset_id_start_on_end_on_index")
  @@index([start_on, end_on], map: "equipment_loans_start_on_end_on_index")
  @@index([user_id], map: "equipment_loans_user_id_index")
  @@index([status, end_on], map: "equipment_loans_status_end_on_index")
  @@index([handed_out_by], map: "equipment_loans_handed_out_by_index")
  @@index([returned_by], map: "equipment_loans_returned_by_index")
  @@index([cancelled_by], map: "equipment_loans_cancelled_by_index")
}

/// ผู้ใช้ / กลุ่มสิทธิ์ที่เปิดดูบัญชีที่จำกัดสิทธิ์ (credentials.access_mode = restricted) ได้ — แถวละ user_id หรือ group_key
model credential_access {
  id            BigInt      @id @default(autoincrement())
  credential_id BigInt
  user_id       BigInt?
  group_key     String?     @db.Citext
  created_by    BigInt?
  created_at    DateTime?   @db.Timestamp(0)
  credentials   credentials @relation(fields: [credential_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "credential_access_credential_id_foreign")
  users         users?      @relation("credential_access_user", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "credential_access_user_id_foreign")
  creator       users?      @relation("credential_access_creator", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "credential_access_created_by_foreign")

  @@unique([credential_id, user_id], map: "credential_access_credential_id_user_id_unique")
  @@unique([credential_id, group_key], map: "credential_access_credential_id_group_key_unique")
  @@index([user_id], map: "credential_access_user_id_index")
  @@index([group_key], map: "credential_access_group_key_index")
  @@index([created_by], map: "credential_access_created_by_index")
}

/// ยืม VPN — บัญชี VPN มาจากคลังบัญชี/รหัสผ่าน (credentials หมวด VPN) — routes/vpn-loans.ts
/// status: requested (ขอใช้) → active (ฝ่าย IT มอบบัญชี + กำหนดวันหมดอายุ) → renewal_requested / cancel_requested (ผู้ใช้เลือก → ใบแจ้งงาน ticket_id)
///         → active (ต่ออายุแล้ว) / ended (เลิกใช้) — rejected / cancelled = ไม่ได้มอบ — ห้ามลบ (เก็บเป็นประวัติ)
model vpn_loans {
  id                   BigInt       @id @default(autoincrement())
  uuid                 String       @unique(map: "vpn_loans_uuid_unique") @db.Citext
  user_id              BigInt
  department           String?      @db.Citext
  purpose              String       @db.Citext
  /// ขอผ่านใบแจ้งงาน (อื่นๆ → ขอใช้งาน VPN): วันที่ผู้ขอต้องการเริ่มใช้
  requested_from       DateTime?    @db.Date
  /// วันที่ผู้ขอต้องการใช้ถึง (ตอนขอ)
  requested_until      DateTime?    @db.Date
  status               String       @default("requested") @db.Citext
  credential_id        BigInt?
  assigned_by          BigInt?
  assigned_at          DateTime?    @db.Timestamp(0)
  start_on             DateTime?    @db.Date
  /// ใช้ได้ถึงวันนี้ (เวลาไทย)
  expires_on           DateTime?    @db.Date
  /// แจ้งเตือนผู้ใช้ล่วงหน้ากี่วันก่อนหมดอายุ
  notify_days_before   Int          @default(7) @db.SmallInt
  /// แจ้งเตือนล่วงหน้าแล้วสำหรับวันหมดอายุนี้ (ล้างเมื่อเปลี่ยนวันหมดอายุ)
  reminded_for         DateTime?    @db.Date
  /// แจ้งเตือนหมดอายุแล้ว (ผู้ใช้ + ผู้ดูแล) สำหรับวันหมดอายุนี้
  expired_notified_for DateTime?    @db.Date
  /// ผู้ใช้เลือก: ต่ออายุถึงวันที่ / เหตุผล → ใบแจ้งงาน
  renew_until          DateTime?    @db.Date
  choice_reason        String?      @db.Citext
  choice_at            DateTime?    @db.Timestamp(0)
  ticket_id            BigInt?
  ended_at             DateTime?    @db.Timestamp(0)
  ended_by             BigInt?
  end_note             String?      @db.Citext
  /// ผู้จัดการฝ่าย IT อนุมัติการมอบบัญชี (migration 20261214090000_vpn_approval_revoke)
  approved_by          BigInt?
  approved_at          DateTime?    @db.Timestamp(0)
  /// ผู้ขอกด "ได้รับแล้ว" (ปิดใบแจ้งงาน) — ก่อนนี้ดูรหัสไม่ได้
  received_at          DateTime?    @db.Timestamp(0)
  /// เจ้าหน้าที่ IT เรียกคืนรหัส — ผู้ใช้ดูชื่อผู้ใช้ / รหัสผ่านไม่ได้อีก
  revoked_at           DateTime?    @db.Timestamp(0)
  revoked_by           BigInt?
  /// แจ้งเตือนหมดอายุล่าสุดวันที่ (หมดอายุแล้วแจ้งทุกวันจนกว่าจะต่ออายุ)
  expired_notified_on  DateTime?    @db.Date
  created_at           DateTime?    @db.Timestamp(0)
  updated_at           DateTime?    @db.Timestamp(0)
  user                 users        @relation("vpn_loans_user", fields: [user_id], references: [id], onUpdate: Restrict, map: "vpn_loans_user_id_foreign")
  credential           credentials? @relation(fields: [credential_id], references: [id], onUpdate: Restrict, map: "vpn_loans_credential_id_foreign")
  assigner             users?       @relation("vpn_loans_assigned", fields: [assigned_by], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "vpn_loans_assigned_by_foreign")
  ender                users?       @relation("vpn_loans_ended", fields: [ended_by], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "vpn_loans_ended_by_foreign")
  ticket               it_tickets?  @relation(fields: [ticket_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "vpn_loans_ticket_id_foreign")

  @@index([user_id], map: "vpn_loans_user_id_index")
  @@index([status, expires_on], map: "vpn_loans_status_expires_on_index")
  @@index([credential_id], map: "vpn_loans_credential_id_index")
  @@index([ticket_id], map: "vpn_loans_ticket_id_index")
  @@index([assigned_by], map: "vpn_loans_assigned_by_index")
  @@index([ended_by], map: "vpn_loans_ended_by_index")
}

/// การยอมรับนโยบายของระบบ (app_settings.system_policy) — 1 แถวต่อผู้ใช้ต่อเวอร์ชัน
model policy_acceptances {
  id             BigInt    @id @default(autoincrement())
  user_id        BigInt
  version        Int
  accepted_at    DateTime  @db.Timestamp(0)
  ip             String?   @db.Citext
  user_agent     String?   @db.Citext
  /// ชื่อ-สกุลที่ประทับตอนยอมรับ
  name_stamp     String?   @db.Citext
  /// สำเนาลายเซ็นของเอกสาร — ยังไม่มีลายเซ็นตอนยอมรับ = เติมเมื่อผู้ใช้อัปโหลด (saveSignature)
  signature_path String?   @db.Citext
  signature_at   DateTime? @db.Timestamp(0)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "policy_acceptances_user_id_foreign")

  @@unique([user_id, version], map: "policy_acceptances_user_version_unique")
  @@index([version], map: "policy_acceptances_version_index")
}

/// จอง ZOOM — ผู้ใช้จองช่วงวันเวลา → ฝ่าย IT (zoom.manage) รับงาน (accepted) → ส่งลิงก์ (confirmed + ใบแจ้งงานที่ปิดแล้ว ticket_id ลง KPI ของผู้รับงาน)
/// หรือแจ้งกลับว่ามีการใช้งานแล้ว (rejected + reject_reason) / ผู้จองยกเลิก (cancelled) — routes/zoom.ts
model zoom_bookings {
  id                 BigInt            @id @default(autoincrement())
  uuid               String            @unique(map: "zoom_bookings_uuid_unique") @db.Citext
  user_id            BigInt
  department         String?           @db.Citext
  branch_id          BigInt?
  title              String            @db.Citext
  details            String?           @db.Citext
  start_on           DateTime          @db.Date
  start_time         String            @db.Citext
  end_on             DateTime          @db.Date
  end_time           String            @db.Citext
  /// pending (รอ IT รับงาน) / accepted (รับงานแล้ว) / needs_change (IT แจ้งว่าไม่ว่าง รอผู้จองแก้วันเวลา) / confirmed (ส่งลิงก์แล้ว) / rejected (ข้อมูลเดิม) / cancelled
  status             String            @default("pending") @db.Citext
  assignee_id        BigInt?
  accepted_at        DateTime?         @db.Timestamp(0)
  meeting_link       String?           @db.Citext
  /// ข้อความเชิญเต็มจาก ZOOM ที่ฝ่าย IT วาง (ดึง Topic / ลิงก์ / Meeting ID / Passcode ออกมา)
  link_note          String?           @db.Citext
  meeting_topic      String?           @db.Citext
  meeting_id         String?           @db.Citext
  passcode           String?           @db.Citext
  /// บัญชี ZOOM ที่ฝ่าย IT ใช้ (ข้อมูล Drop Down list zoom_account เก็บเป็นข้อความ)
  zoom_account       String?           @db.Citext
  confirmed_by       BigInt?
  confirmed_at       DateTime?         @db.Timestamp(0)
  link_received_at   DateTime?         @db.Timestamp(0)
  reject_reason      String?           @db.Citext
  rejected_by        BigInt?
  rejected_at        DateTime?         @db.Timestamp(0)
  cancelled_by       BigInt?
  cancelled_at       DateTime?         @db.Timestamp(0)
  /// ผู้จองยกเลิกหลังส่งลิงก์แล้ว → ฝ่าย IT ยกเลิกห้องประชุมในระบบ ZOOM แล้วกดยืนยัน (NULL + meeting_link + cancelled = รอยกเลิกลิงก์)
  link_removed_at    DateTime?         @db.Timestamp(0)
  link_removed_by    BigInt?
  /// ใบแจ้งงาน (เรื่องอื่นๆ) ที่สร้างตอนจอง — สถานะเดินตามการจอง (it_tickets.source = 'zoom'), อนุมัติผลแล้วขึ้นชีต KPI ของผู้รับงาน
  ticket_id          BigInt?
  /// จองมาพร้อมการจองห้องประชุม — ยกเลิกห้อง = ยกเลิก ZOOM, เปลี่ยนเวลาห้อง = เวลา ZOOM เปลี่ยนตาม
  meeting_booking_id BigInt?
  created_at         DateTime?         @db.Timestamp(0)
  updated_at         DateTime?         @db.Timestamp(0)
  users              users             @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "zoom_bookings_user_id_foreign")
  it_tickets         it_tickets?       @relation(fields: [ticket_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "zoom_bookings_ticket_id_foreign")
  meeting_bookings   meeting_bookings? @relation(fields: [meeting_booking_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "zoom_bookings_meeting_booking_id_foreign")

  @@index([start_on, end_on], map: "zoom_bookings_start_on_end_on_index")
  @@index([user_id], map: "zoom_bookings_user_id_index")
  @@index([status], map: "zoom_bookings_status_index")
  @@index([ticket_id], map: "zoom_bookings_ticket_id_index")
  @@index([meeting_booking_id], map: "zoom_bookings_meeting_booking_id_index")
}

/// ตัวนับเวอร์ชันข้อมูล (แถว name = "data") — API เพิ่มค่าหลังบันทึกตารางที่หน้าจอแสดงผล (routes/sync.ts) แทนการนับแถวทุกตารางทุกครั้งที่ถาม /sync/version
model sync_versions {
  name       String    @id @db.Citext
  version    BigInt    @default(0)
  updated_at DateTime? @db.Timestamp(0)
}

/// คนขับรถ (เมนู จองรถ → คนขับรถ) — ผู้จัดคิวเลือกให้การจองที่ขอคนขับ, คนขับคนเดียวกันช่วงเวลาซ้อนไม่ได้ (routes/vehicles.ts)
model vehicle_drivers {
  id               BigInt             @id @default(autoincrement())
  name             String             @db.Citext
  nickname         String?            @db.Citext
  branch_id        BigInt?
  is_active        Boolean            @default(true)
  sort_order       Int                @default(0) @db.SmallInt
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  branches         branches?          @relation(fields: [branch_id], references: [id], onUpdate: Restrict, map: "vehicle_drivers_branch_id_foreign")
  vehicle_bookings vehicle_bookings[]

  @@index([branch_id], map: "vehicle_drivers_branch_id_index")
}

/// ข้อมูลหลัก Vendor — ประเภทเก็บเป็นข้อความ (ข้อมูล Drop Down list vendor_type)
model vendors {
  id            BigInt          @id @default(autoincrement())
  name          String          @db.Citext
  tax_id        String?         @db.Citext
  address       String          @db.Citext
  contact_name  String          @db.Citext
  contact_phone String          @db.Citext
  vendor_type   String          @db.Citext
  /// ลิงก์ตำแหน่งจาก Google Maps (http/https เท่านั้น)
  map_url       String?         @db.Citext
  is_active     Boolean         @default(true)
  created_at    DateTime?       @db.Timestamp(0)
  updated_at    DateTime?       @db.Timestamp(0)
  deleted_at    DateTime?       @db.Timestamp(0)
  repair_orders repair_orders[]
  files         vendor_files[]

  @@index([name], map: "vendors_name_index")
}

/// ไฟล์ของประกาศข่าวสาร — kind: cover (รูปหน้าปก 1 รูป) / document (เอกสารแนบ)
model announcement_files {
  id              BigInt        @id @default(autoincrement())
  announcement_id BigInt
  kind            String        @db.Citext
  original_name   String        @db.Citext
  path            String        @db.Citext
  mime            String        @db.Citext
  size            Int
  uploaded_by     BigInt?
  created_at      DateTime?     @db.Timestamp(0)
  updated_at      DateTime?     @db.Timestamp(0)
  announcements   announcements @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "announcement_files_announcement_id_foreign")
  users           users?        @relation(fields: [uploaded_by], references: [id], onUpdate: Restrict, map: "announcement_files_uploaded_by_foreign")

  @@index([announcement_id], map: "announcement_files_announcement_id_index")
  @@index([uploaded_by], map: "announcement_files_uploaded_by_index")
}

/// เนื้อหานโยบายของแต่ละฉบับ — เอกสารการยอมรับแสดงเนื้อหาของฉบับที่ผู้ใช้ยอมรับ
model policy_versions {
  version      Int             @id
  /// เรื่องของนโยบาย — ฉบับที่คัดลอกมาอยู่เรื่องเดียวกัน
  group_id     BigInt
  title        String          @default("") @db.Citext
  sections     Json
  created_at   DateTime?       @db.Timestamp(0)
  /// เคยตั้งเป็นฉบับที่แสดงให้ผู้ใช้แล้ว (null = ร่าง)
  published_at DateTime?       @db.Timestamp(0)
  created_by   BigInt?
  updated_at   DateTime?       @db.Timestamp(0)
  users        users?          @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "policy_versions_created_by_foreign")
  files        policy_files[]
  policy_group policy_groups   @relation("policy_group_versions", fields: [group_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "policy_versions_group_id_foreign")
  shown_in     policy_groups[] @relation("policy_group_current")

  @@index([created_by], map: "policy_versions_created_by_index")
  @@index([group_id], map: "policy_versions_group_id_index")
}

/// เรื่องของนโยบายที่ต้องยอมรับ — แสดงได้หลายเรื่องพร้อมกัน เรียงตาม sort_order (ลำดับที่ให้ยอมรับ)
model policy_groups {
  id              BigInt            @id @default(autoincrement())
  sort_order      Int               @default(0)
  /// ฉบับที่แสดงให้ผู้ใช้ (null = ไม่แสดง)
  current_version Int?
  created_at      DateTime?         @db.Timestamp(0)
  updated_at      DateTime?         @db.Timestamp(0)
  versions        policy_versions[] @relation("policy_group_versions")
  current         policy_versions?  @relation("policy_group_current", fields: [current_version], references: [version], onDelete: Restrict, onUpdate: Restrict, map: "policy_groups_current_version_foreign")

  @@index([current_version], map: "policy_groups_current_version_index")
}

/// ไฟล์แนบของนโยบายแต่ละฉบับ — เปิดดูได้ตอนอ่านนโยบาย
model policy_files {
  id              BigInt           @id @default(autoincrement())
  version         Int?
  original_name   String           @db.Citext
  path            String           @db.Citext
  mime            String           @db.Citext
  size            Int
  uploaded_by     BigInt?
  created_at      DateTime?        @db.Timestamp(0)
  updated_at      DateTime?        @db.Timestamp(0)
  users           users?           @relation(fields: [uploaded_by], references: [id], onUpdate: Restrict, map: "policy_files_uploaded_by_foreign")
  policy_versions policy_versions? @relation(fields: [version], references: [version], onDelete: Restrict, onUpdate: Restrict, map: "policy_files_version_foreign")

  @@index([uploaded_by], map: "policy_files_uploaded_by_index")
  @@index([version], map: "policy_files_version_index")
}

/// นโยบายอื่นๆ — เอกสารให้เปิดอ่าน ไม่ต้องกดยอมรับ
model other_policies {
  id          BigInt               @id @default(autoincrement())
  title       String               @db.Citext
  description String?              @db.Citext
  /// หัวข้อ + รายละเอียด [{title, body}] เหมือนนโยบายที่ต้องยอมรับ
  sections    Json?
  sort_order  Int                  @default(0)
  is_active   Boolean              @default(true)
  created_by  BigInt?
  created_at  DateTime?            @db.Timestamp(0)
  updated_at  DateTime?            @db.Timestamp(0)
  users       users?               @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "other_policies_created_by_foreign")
  files       other_policy_files[]

  @@index([created_by], map: "other_policies_created_by_index")
}

model other_policy_files {
  id              BigInt         @id @default(autoincrement())
  other_policy_id BigInt
  original_name   String         @db.Citext
  path            String         @db.Citext
  mime            String         @db.Citext
  size            Int
  uploaded_by     BigInt?
  created_at      DateTime?      @db.Timestamp(0)
  updated_at      DateTime?      @db.Timestamp(0)
  other_policies  other_policies @relation(fields: [other_policy_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "other_policy_files_other_policy_id_foreign")
  users           users?         @relation(fields: [uploaded_by], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "other_policy_files_uploaded_by_foreign")

  @@index([other_policy_id], map: "other_policy_files_other_policy_id_index")
  @@index([uploaded_by], map: "other_policy_files_uploaded_by_index")
}

/// ไฟล์เอกสารบริษัทของ Vendor
model vendor_files {
  id            BigInt    @id @default(autoincrement())
  vendor_id     BigInt
  original_name String    @db.Citext
  path          String    @db.Citext
  mime          String    @db.Citext
  size          Int
  uploaded_by   BigInt?
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  vendors       vendors   @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "vendor_files_vendor_id_foreign")
  users         users?    @relation(fields: [uploaded_by], references: [id], onUpdate: Restrict, map: "vendor_files_uploaded_by_foreign")

  @@index([vendor_id], map: "vendor_files_vendor_id_index")
  @@index([uploaded_by], map: "vendor_files_uploaded_by_index")
}

/// รายการส่งซ่อม: ส่งเครื่องให้ vendor (sent) → รับคืน (returned) — item_no / item_name = สำเนาตอนส่ง
model repair_orders {
  id                     BigInt               @id @default(autoincrement())
  uuid                   String               @unique(map: "repair_orders_uuid_unique") @db.Citext
  asset_id               BigInt?
  ticket_id              BigInt?
  item_no                String?              @db.Citext
  item_name              String               @db.Citext
  /// รายละเอียดอาการเสีย
  symptom                String               @db.Citext
  /// รายละเอียดอุปกรณ์เพิ่มเติม (ไม่บังคับ)
  item_details           String?              @db.Citext
  /// เลขที่เอกสาร (ไม่บังคับ)
  document_no            String?              @db.Citext
  /// S/N ที่กรอกเองเมื่อสินทรัพย์ไม่มี S/N (หรือไม่ได้ผูกสินทรัพย์) — ไม่เขียนกลับไปที่สินทรัพย์
  item_serial            String?              @db.Citext
  vendor_id              BigInt
  /// วันเวลาที่ส่งซ่อม เวลาไทย
  sent_on                DateTime             @db.Date
  sent_time              String               @db.Citext
  /// ผู้ส่งซ่อม (เจ้าของอุปกรณ์) ที่เลือกจากผู้ใช้ในระบบ — พิมพ์ชื่อเอง = NULL (ดู sender_name)
  sent_by_id             BigInt?
  /// ชื่อผู้ส่งซ่อม (เจ้าของอุปกรณ์) ที่พิมพ์ — แถวเดิม NULL = ใช้ชื่อของ sent_by_id
  sender_name            String?              @db.Citext
  /// แจ้งเตือนตามงาน: จำนวนวันหลังวันที่ส่งซ่อม (ตั้งต้น 7) — follow_up_on = sent_on + follow_up_days (GENERATED STORED ห้ามเขียนเอง)
  follow_up_days         Int                  @default(7) @db.SmallInt
  follow_up_on           DateTime?            @db.Date @default(dbgenerated("(sent_on + (follow_up_days)::integer)"))
  /// แจ้งที่กระดิ่งแล้วสำหรับวันกำหนดใด
  follow_up_notified_for DateTime?            @db.Date
  status                 String               @default("sent") @db.Citext
  returned_at            DateTime?            @db.Timestamp(0)
  received_by_id         BigInt?
  return_note            String?              @db.Citext
  /// สถานะสินทรัพย์ก่อนส่งซ่อม — รับคืน / ยกเลิก = กลับเป็นค่านี้
  asset_prev_status      String?              @db.Citext
  cancelled_at           DateTime?            @db.Timestamp(0)
  cancelled_by_id        BigInt?
  cancel_reason          String?              @db.Citext
  created_by             BigInt
  created_at             DateTime?            @db.Timestamp(0)
  updated_at             DateTime?            @db.Timestamp(0)
  assets                 assets?              @relation(fields: [asset_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "repair_orders_asset_id_foreign")
  it_tickets             it_tickets?          @relation(fields: [ticket_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "repair_orders_ticket_id_foreign")
  vendors                vendors              @relation(fields: [vendor_id], references: [id], onUpdate: Restrict, map: "repair_orders_vendor_id_foreign")
  sent_by                users?               @relation("repair_orders_sent_by", fields: [sent_by_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "repair_orders_sent_by_id_foreign")
  received_by            users?               @relation("repair_orders_received_by", fields: [received_by_id], references: [id], onUpdate: Restrict, map: "repair_orders_received_by_id_foreign")
  cancelled_by           users?               @relation("repair_orders_cancelled_by", fields: [cancelled_by_id], references: [id], onUpdate: Restrict, map: "repair_orders_cancelled_by_id_foreign")
  creator                users                @relation("repair_orders_created_by", fields: [created_by], references: [id], onUpdate: Restrict, map: "repair_orders_created_by_foreign")
  files                  repair_order_files[]
  parts                  repair_order_parts[]
  events                 it_ticket_events[]

  @@index([status, sent_on], map: "repair_orders_status_sent_on_index")
  @@index([status, follow_up_on], map: "repair_orders_status_follow_up_on_index")
  @@index([asset_id], map: "repair_orders_asset_id_index")
  @@index([ticket_id], map: "repair_orders_ticket_id_index")
  @@index([vendor_id], map: "repair_orders_vendor_id_index")
  @@index([sent_by_id], map: "repair_orders_sent_by_id_index")
  @@index([received_by_id], map: "repair_orders_received_by_id_index")
  @@index([created_by], map: "repair_orders_created_by_index")
  @@index([cancelled_by_id], map: "repair_orders_cancelled_by_id_index")
}

/// เอกสาร/รูปของรายการส่งซ่อม — kind: send (ใบส่งซ่อม) / return (ตอนรับคืน)
/// อะไหล่ที่ร้านเปลี่ยน (กรอกตอนรับเครื่องคืน) — บันทึกผลใบแจ้งซ่อมดึงไปเติมรายการอะไหล่
model repair_order_parts {
  id              BigInt        @id @default(autoincrement())
  repair_order_id BigInt
  name            String        @db.Citext
  quantity        Int           @default(1)
  created_at      DateTime?     @db.Timestamp(0)
  repair_orders   repair_orders @relation(fields: [repair_order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "repair_order_parts_repair_order_id_foreign")

  @@index([repair_order_id], map: "repair_order_parts_repair_order_id_index")
}

model repair_order_files {
  id              BigInt        @id @default(autoincrement())
  repair_order_id BigInt
  kind            String        @db.Citext
  original_name   String        @db.Citext
  path            String        @db.Citext
  mime            String        @db.Citext
  size            Int
  uploaded_by     BigInt?
  created_at      DateTime?     @db.Timestamp(0)
  updated_at      DateTime?     @db.Timestamp(0)
  repair_orders   repair_orders @relation(fields: [repair_order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "repair_order_files_repair_order_id_foreign")
  users           users?        @relation(fields: [uploaded_by], references: [id], onUpdate: Restrict, map: "repair_order_files_uploaded_by_foreign")

  @@index([repair_order_id], map: "repair_order_files_repair_order_id_index")
  @@index([uploaded_by], map: "repair_order_files_uploaded_by_index")
}

/// เอกสารแนบของสัญญา vendor (ไฟล์ละ ≤ 5MB ≤ 10 ไฟล์ต่อครั้ง) — ไฟล์เก็บที่ contracts/{id}/
model contract_files {
  id            BigInt    @id @default(autoincrement())
  contract_id   BigInt
  original_name String    @db.Citext
  path          String    @db.Citext
  mime          String    @db.Citext
  size          Int
  uploaded_by   BigInt?
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  contracts     contracts @relation(fields: [contract_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "contract_files_contract_id_foreign")
  users         users?    @relation(fields: [uploaded_by], references: [id], onUpdate: Restrict, map: "contract_files_uploaded_by_foreign")

  @@index([contract_id], map: "contract_files_contract_id_index")
  @@index([uploaded_by], map: "contract_files_uploaded_by_index")
}

/// Fixed Assets จาก STEC SyteLine API — สำเนาอ่านอย่างเดียว 1 แถวต่อ (site, fanum) — services/fixed-asset-sync.ts
model fixed_assets {
  id                 BigInt    @id @default(autoincrement())
  site               String    @db.Citext
  fanum              String    @db.Citext
  branch_id          BigInt?
  site_name          String?   @db.Citext
  description        String?   @db.Citext
  fa_class           String?   @db.Citext
  fa_dept            String?   @db.Citext
  fa_type            String?   @db.Citext
  fa_status          String?   @db.Citext
  fa_location        String?   @db.Citext
  acquired_on        DateTime? @db.Date
  depr_start_on      DateTime? @db.Date
  disposed_on        DateTime? @db.Date
  acq_cost           Decimal?  @db.Decimal(18, 2)
  accum_depr         Decimal?  @db.Decimal(18, 2)
  nbv                Decimal?  @db.Decimal(18, 2)
  salvage            Decimal?  @db.Decimal(18, 2)
  depr_method        String?   @db.Citext
  depr_rate          Decimal?  @db.Decimal(9, 4)
  useful_life        Int?
  /// แถวเต็มจากรายงาน (ทุกฟิลด์)
  source_data        Json
  /// SHA-256 ของข้อมูลที่ไม่ใช่ตัวเลขค่าเสื่อมรายงวด — ตรวจว่าเปลี่ยนจริง
  row_hash           String    @db.Citext
  source_recorded_at DateTime? @db.Timestamp(0)
  /// period ที่ใช้ดึง (ตัวเลขค่าเสื่อม ณ วันนั้น)
  as_of              DateTime  @db.Date
  asset_id           BigInt?
  /// auto | manual — manual = การซิงค์ไม่เปลี่ยนการผูก
  link_source        String?   @db.Citext
  linked_by          BigInt?
  /// ไม่พบในการดึงครั้งล่าสุด (ไม่ลบแถว)
  missing_since      DateTime? @db.Timestamp(0)
  first_synced_at    DateTime  @db.Timestamp(0)
  synced_at          DateTime  @db.Timestamp(0)
  changed_at         DateTime? @db.Timestamp(0)
  branches           branches? @relation(fields: [branch_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fixed_assets_branch_id_foreign")
  assets             assets?   @relation(fields: [asset_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fixed_assets_asset_id_foreign")
  linker             users?    @relation("fixed_assets_linked_by", fields: [linked_by], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fixed_assets_linked_by_foreign")

  @@unique([site, fanum], map: "fixed_assets_site_fanum_unique")
  @@index([fanum], map: "fixed_assets_fanum_index")
  @@index([asset_id], map: "fixed_assets_asset_id_index")
  @@index([branch_id], map: "fixed_assets_branch_id_index")
  @@index([linked_by], map: "fixed_assets_linked_by_index")
  @@index([fa_status], map: "fixed_assets_fa_status_index")
}

model fixed_asset_classdepts {
  id          BigInt   @id @default(autoincrement())
  site        String   @db.Citext
  class_dept  String   @db.Citext
  description String?  @db.Citext
  synced_at   DateTime @db.Timestamp(0)

  @@unique([site, class_dept], map: "fixed_asset_classdepts_site_class_dept_unique")
}

/// ประวัติการซิงค์ Fixed Assets — ห้ามแก้/ลบผ่าน API
model fixed_asset_sync_runs {
  id           BigInt    @id @default(autoincrement())
  /// schedule | manual
  run_trigger  String    @db.Citext
  triggered_by BigInt?
  /// running | ok | partial | failed
  status       String    @default("running") @db.Citext
  /// { [site]: { fetched, inserted, updated, unchanged, missing, error? } }
  stats        Json?
  error        String?   @db.Citext
  started_at   DateTime  @db.Timestamp(0)
  finished_at  DateTime? @db.Timestamp(0)
  users        users?    @relation(fields: [triggered_by], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fixed_asset_sync_runs_triggered_by_foreign")

  @@index([started_at], map: "fixed_asset_sync_runs_started_at_index")
  @@index([triggered_by], map: "fixed_asset_sync_runs_triggered_by_index")
}
